# Copy to .env for local development. Do not commit actual credentials.
NODE_ENV=development
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_local_database_user
DB_PASSWORD=your_local_database_password
DB_NAME=evoconnect
APP_URL=http://localhost:3001

# Set unique, strong values in production. Generate with crypto.randomBytes(48).
JWT_SECRET=replace_with_a_random_secret
# Optional: defaults to a distinct key derived from JWT_SECRET.
# SESSION_SECRET=replace_with_a_different_random_secret
# Creates the named real administrator on startup if that email does not exist.
# Existing administrator passwords are preserved; use npm run create-admin -- --reset-password to reset.
ADMIN_DEFAULT_PASSWORD=replace_with_a_strong_temporary_password
ADMIN_EMAIL=admin@example.com
# Optional legacy shared CMS password. Real admins can use their account password or portal session.
# CMS_ADMIN_PASSWORD=

# PDFs must be outside public/, uploads/, or other served directories.
# Default: ../evoconnect-private/capabilities relative to this checkout.
# Mount this directory on persistent storage and include it in backups.
# CAPABILITY_STORAGE_DIR=/absolute/private/persistent/capabilities

# Optional SMTP credentials for welcome and password-reset email delivery.
# EMAIL_USER=
# EMAIL_PASSWORD=
