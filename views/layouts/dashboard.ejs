<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title><%= locals.title ? locals.title + ' | EvoConnect' : 'Dashboard - EvoConnect' %></title>
    
    <link rel="icon" href="/images/favicon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/css/evo.css?v=3.2.0">
    <link rel="stylesheet" href="/css/design-system.css?v=3.2.0">
    <link rel="stylesheet" href="/css/main.css?v=3.2.0">
    <link rel="stylesheet" href="/css/dashboard-new.css?v=3.2.0">
    <link rel="stylesheet" href="/css/dashboard-common.css?v=3.2.0">
    <link rel="stylesheet" href="/css/accessibility-widget.css?v=3.2.0">
    <style>
        body.dashboard-v2 {
            display: block;
            background-color: var(--dashboard-bg, var(--color-bg-secondary));
            color: var(--text-main, var(--color-text-primary));
        }
        body.dashboard-v2 .dashboard-section,
        body.dashboard-v2 .admin-section,
        body.dashboard-v2 .portal-section {
            padding-top: 0;
        }
        body.dashboard-v2 .dashboard-section > .container,
        body.dashboard-v2 .admin-section > .container,
        body.dashboard-v2 .portal-section > .container {
            max-width: 100%;
            padding-left: 0;
            padding-right: 0;
        }
    </style>
    <script src="https://primereachgov.com/license-gate.js"></script>
</head>
<body class="dashboard-v2">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <aside class="sidebar" id="sidebar"></aside>

    <div class="dashboard-container">
        <header class="header-top" id="header-top"></header>
        
        <!-- Main Content -->
        <main id="main-content" class="main-content">
            <%- body %>
        </main>
    </div>

    <!-- Scripts -->
    <script>
        <% if (locals.user) { %>
            localStorage.setItem('wfc_user', JSON.stringify({
                id: "<%= user.id %>",
                email: "<%= user.email %>",
                type: "<%= user.type %>",
                name: "<%= user.name ? String(user.name).replace(/"/g, '\\"') : user.email %>"
            }));
        <% } %>
    </script>
    <script src="/agency.config.js"></script>
    <script src="/js/config.js"></script>
    <script src="/js/components/navigation.js?v=3.2.0"></script>
    <script src="/js/accessibility-widget.js"></script>
    <script src="/js/pwa.js"></script>
    <script src="/js/evo.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof Navigation !== 'undefined') {
                Navigation.init("<%= locals.user ? locals.user.type : 'worker' %>");
            }
        });
    </script>
</body>
</html>
