};

const navCfg = NAV_CONFIG[currentRole] || NAV_CONFIG.worker;
%>
<!DOCTYPE html>
<html lang="en" data-theme="dashboard">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title><%= locals.title ? locals.title : 'Dashboard — EVOConnect' %></title>
    
    <link rel="icon" href="/images/favicon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/css/design-system.css?v=3.4.1">
    <link rel="stylesheet" href="/css/main.css?v=3.4.1">
    <link rel="stylesheet" href="/css/dashboard-new.css?v=3.4.1">
    <link rel="stylesheet" href="/css/dashboard-common.css?v=3.6.2">
    <link rel="stylesheet" href="/css/accessibility-widget.css?v=3.4.1">
    <link rel="stylesheet" href="/css/faq.css?v=3.4.1">
  <link rel="stylesheet" href="/css/directory-cards.css?v=1">
  <meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
  <link rel="stylesheet" href="/css/role-workflows.css?v=1">
</head>
<body class="dashboard-v2">
    <% if(locals.user?.demo) { %><div role="status" style="position:fixed;bottom:0;left:0;right:0;z-index:2000;padding:.5rem;text-align:center;background:#0f172a;color:#fff">Demo preview · sample data · read only · <a href="/logout" style="color:#67e8f9">Exit demo</a></div><% } %>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Server-Rendered Caltrans Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <a href="<%= navCfg.dashboardHref %>" class="sidebar-brand-link">
                <img src="/images/favicon.png" alt="EVOConnect">
                <span>EVOConnect</span>
            </a>
            <button class="sidebar-close-btn" aria-label="Close menu" onclick="Navigation.closeSidebar()">&times;</button>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-nav-section-title">
                <%= navCfg.title %>
            </div>
            <% navCfg.items.forEach(function(item) { %>
                <a href="<%= item.href %>" class="nav-item">
                    <span aria-hidden="true" class="nav-item-icon"><%= item.icon %></span>
                    <span><%= item.label %></span>
                </a>
            <% }) %>

            <!-- Quick Role / Demo Switcher -->
            <div class="demo-switch-label">
                Switch Demo Portal
            </div>
            <div class="demo-switch-grid">
                <a href="/auth/demo/worker" class="demo-switch-link<%= currentRole === 'worker' ? ' active' : '' %>">👷 Labor</a>
                <a href="/auth/demo/business" class="demo-switch-link<%= currentRole === 'business' ? ' active' : '' %>">🏢 Business</a>
                <a href="/auth/demo/prime" class="demo-switch-link<%= currentRole === 'prime' ? ' active' : '' %>">🏗️ Prime</a>
                <a href="/auth/demo/admin" class="demo-switch-link<%= currentRole === 'admin' ? ' active' : '' %>">🛡️ Admin</a>
            </div>
        </nav>

        <div class="sidebar-footer">
            <a href="/?public=1" class="sidebar-footer-link">
                <span class="sidebar-footer-link-icon">🌐</span> Back to Public Site
            </a>
            <a href="/logout" onclick="localStorage.removeItem('wfc_user');" class="sidebar-footer-link sidebar-signout-btn">
                <span class="sidebar-footer-link-icon">🚪</span> Sign Out
            </a>
        </div>
    </aside>

    <div class="dashboard-container">
        <!-- Server-Rendered Caltrans Top Header -->
        <header class="header-top" id="header-top">
            <div class="header-top-left">
                <button id="mobile-toggle" class="mobile-toggle-btn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="sidebar">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="12" x2="20" y2="12"></line>
                        <line x1="4" y1="6" x2="20" y2="6"></line>
                        <line x1="4" y1="18" x2="20" y2="18"></line>
                    </svg>
                </button>
                <span class="header-portal-title"><%= navCfg.title %></span>
            </div>

            <div class="header-top-right">
                <!-- Messages Shortcut -->
                <a href="<%= navCfg.messagesHref %>" class="btn btn-sm btn-outline messages-shortcut-btn">
                    💬 Messages
                </a>

                <!-- Notification Bell -->
                <div class="notification-container">
                    <button id="notification-bell" class="notification-bell" aria-label="Notifications">
                        <span aria-hidden="true">🔔</span>
                        <span id="notification-badge" class="badge notification-badge">0</span>
                    </button>
                    <div id="notification-announcer" class="sr-only" role="status" aria-live="polite"></div>
                    <div id="notification-dropdown" class="notification-dropdown">
                        <div class="notification-dropdown-header">
                            <span>Notifications</span>
                            <a href="<%= navCfg.messagesHref %>">View Messages</a>
                        </div>
                        <div id="notification-list" class="notification-list">
                            <div class="notification-loading" aria-hidden="true">
                                <span class="notification-loading-bar"></span>
                                <span class="notification-loading-bar"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Info -->
                <div class="header-user-info">
                    <div class="user-name"><%= userName %></div>
                    <div class="user-role"><%= navCfg.title %></div>
                </div>
                <div class="header-avatar">
                    <%= String(userName).charAt(0).toUpperCase() %>
                </div>

                <!-- Always-Visible Sign Out Button -->
                <a href="/logout" onclick="localStorage.removeItem('wfc_user');" class="btn btn-sm sign-out-btn">
                    🚪 Sign Out
                </a>
            </div>
        </header>

        <!-- Main Content -->
        <main id="main-content" class="main-content">
            <%- body %>
        </main>
    </div>

    <!-- Scripts -->
    <script>
        <% if (locals.user) { %>
            localStorage.setItem('wfc_user', JSON.stringify({
                id: "<%= user.id %>",
                email: "<%= user.email %>",
                type: "<%= currentRole %>",
                name: "<%= userName.replace(/"/g, '\\"') %>"
            }));
        <% } %>
    </script>
    <script src="/agency.config.js"></script>
    <script src="/js/config.js"></script>
    <script src="/js/components/navigation.js?v=3.6.3"></script>
    <script src="/js/accessibility-widget.js"></script>
    <script src="/js/pwa.js"></script>
    <script src="/js/evo.js?v=3.6.0"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Highlight current active link in sidebar
            var currentPath = window.location.pathname;
            document.querySelectorAll('#sidebar .nav-item').forEach(function(link) {
                var href = link.getAttribute('href');
                if (href === currentPath || (href !== '<%= navCfg.dashboardHref %>' && currentPath.indexOf(href) === 0)) {
                    link.classList.add('active');
                }
            });
            if (typeof Navigation !== 'undefined') {
                Navigation.setupMobileToggle();
                Navigation.initNotifications("<%= currentRole %>");
            }
        });
    </script>
  <script src="/js/directory-cards.js?v=2" defer></script>
</body>
</html>
