<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title ? locals.title + ' | EVOConnected' : 'EVOConnected' %></title>
  <meta name="description" content="<%= locals.description || 'EVOConnected — Connect the Contract. Build the Future. The government contract workforce ecosystem for workers, businesses, and prime contractors.' %>">
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/design-system.css?v=3.8.0">
  <link rel="stylesheet" href="/css/main.css?v=3.8.4">
  <link rel="stylesheet" href="/css/dashboard-common.css?v=3.8.3">
  <link rel="stylesheet" href="/css/dashboard-new.css?v=3.8.0">
  <link rel="stylesheet" href="/css/home.css?v=3.8.5">
  <link rel="stylesheet" href="/css/accessibility-widget.css?v=3.8.0">
  <script src="https://primereachgov.com/license-gate.js"></script>
  <link rel="stylesheet" href="/css/faq.css?v=3.8.0">
  <link rel="stylesheet" href="/css/directory-cards.css?v=1">
  <meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
  <link rel="stylesheet" href="/css/role-workflows.css?v=1">
</head>
<body data-cms-page="<%= locals.cmsPageSlug || '' %>">
  <a href="#main" class="skip-link">Skip to main content</a>
  <% if (locals.cmsGlobal?.announcement?.enabled) { %>
  <div id="site-announcement" class="site-announcement" style="background:linear-gradient(90deg, #06B6D4, #0D9488);color:#0F172A;padding:0.65rem 1.25rem;font-weight:600;font-size:0.88rem;text-align:center;position:relative;z-index:999;box-shadow:0 2px 8px rgba(0,0,0,0.2);">
    <span><%- locals.cmsGlobal.announcement.message %></span>
    <% if (locals.cmsGlobal.announcement.linkText && locals.cmsGlobal.announcement.linkUrl) { %>
      <a href="<%= locals.cmsGlobal.announcement.linkUrl %>" style="color:#0F172A;text-decoration:underline;margin-left:0.5rem;font-weight:800;"><%= locals.cmsGlobal.announcement.linkText %> &rarr;</a>
    <% } %>
  </div>
  <% } %>
  <%- include('../partials/nav') %>
  <main id="main"><%- body %></main>
  <%- include('../partials/footer') %>
  <script src="/agency.config.js"></script>
  <script src="/js/config.js"></script>
  <script src="/js/accessibility-widget.js"></script>
  <script src="/js/pwa.js?v=3.8.4"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
  <script src="/js/evo.js?v=3.8.1" defer></script>
  <script src="/js/directory-cards.js?v=2" defer></script>
  <script src="/js/cms-renderer.js?v=3.8.0" defer></script>
</body>
</html>
