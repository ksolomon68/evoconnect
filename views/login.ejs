<% const title = locals.title || 'Log In' %>

<section class="auth-section">
  <div class="container">
    <div class="auth-card">
      <div class="auth-logo" style="display:flex;align-items:center;justify-content:center;gap:0.6rem;margin-bottom:0.5rem;">
        <img src="/images/favicon.png" alt="EVOConnect" height="36">
        <span style="font-size:1.5rem;font-weight:800;letter-spacing:-0.02em;color:var(--color-text-primary, #F8FAFC);">EVOConnect</span>
      </div>
      <h1 class="auth-title">Log In to EVOConnect</h1>

      <%- include('./partials/flash') %>

      <form method="POST" action="/login" class="auth-form" novalidate>

        <!-- Email -->
        <div class="form-group">
          <label for="email" class="form-label">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control<%= locals.errors?.email ? ' is-invalid' : '' %>"
            value="<%= locals.values?.email || '' %>"
            required
            autocomplete="email"
            aria-describedby="<%= locals.errors?.email ? 'email-error' : '' %>"
          >
          <% if (locals.errors?.email) { %><span class="field-error" id="email-error" role="alert"><%= errors.email %></span><% } %>
        </div>

        <!-- Password -->
        <div class="form-group">
          <label for="password" class="form-label">Password</label>
          <div class="input-with-toggle">
            <input
              type="password"
              id="password"
              name="password"
              class="form-control<%= locals.errors?.password ? ' is-invalid' : '' %>"
              required
              autocomplete="current-password"
              aria-describedby="<%= locals.errors?.password ? 'password-error' : '' %>"
            >
            <button type="button" class="toggle-password" aria-label="Show password" aria-pressed="false">&#128065;</button>
          </div>
          <% if (locals.errors?.password) { %><span class="field-error" id="password-error" role="alert"><%= errors.password %></span><% } %>
        </div>

        <button type="submit" class="btn-primary btn-full">Log In</button>

        <div class="auth-links">
          <a href="/forgot-password">Forgot your password?</a>
        </div>

      </form>

      <div class="auth-divider"><span>1-Click Demo Logins</span></div>
      <p style="margin-bottom:1rem">Explore each portal with sample data in a read-only preview.</p>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;margin-bottom:1.25rem;">
        <a href="/auth/demo/worker" class="btn btn-outline btn-sm" style="text-align:center;">👷 Labor Demo</a>
        <a href="/auth/demo/business" class="btn btn-outline btn-sm" style="text-align:center;">🏢 Business Demo</a>
        <a href="/auth/demo/prime" class="btn btn-outline btn-sm" style="text-align:center;">🏗️ Prime Demo</a>
        <a href="/auth/demo/admin" class="btn btn-outline btn-sm" style="text-align:center;">🛡️ Admin Demo</a>
      </div>

      <div class="auth-divider"><span>Don't have an account?</span></div>

      <div class="auth-register-links">
        <a href="/labor/register" class="btn btn-outline btn-sm">Register as Worker</a>
        <a href="/business/register" class="btn btn-outline btn-sm">Register as Business</a>
        <a href="/prime/register" class="btn btn-outline btn-sm">Prime Contractor</a>
      </div>

    </div>
  </div>
</section>
