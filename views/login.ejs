<% const title = locals.title || 'Log In' %>

<section class="auth-section">
  <div class="container">
    <div class="auth-card spotlight-card" data-gsap="auth-card">
      <a href="/" class="auth-logo" style="display:flex;align-items:center;justify-content:center;gap:0.65rem;margin-bottom:0.75rem;text-decoration:none;" aria-label="EVOGovCon Home">
        <img src="/images/favicon.png" alt="EVOGovCon" height="36" style="border-radius:8px;">
      </a>
      <div style="text-align:center;margin-bottom:1.75rem;">
        <span class="mono-code" style="display:inline-block;margin-bottom:0.5rem;">AUTHENTICATION GATEWAY</span>
        <h1 class="auth-title" style="margin-bottom:0.35rem;">Access Your Portal</h1>
        <p style="font-size:0.9rem;color:var(--color-text-muted);margin:0;">Sign in to manage your contracting profile, solicitations, and compliance tracks.</p>
      </div>

      <%- include('./partials/flash') %>

      <form method="POST" action="/login" class="auth-form" novalidate>

        <!-- Email -->
        <div class="form-group">
          <label for="email" class="form-label">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control<%= locals.errors?.email ? ' is-invalid' : '' %>"
            value="<%= locals.values?.email || '' %>"
            placeholder="name@company.com"
            required
            autocomplete="email"
            aria-describedby="<%= locals.errors?.email ? 'email-error' : '' %>"
          >
          <% if (locals.errors?.email) { %><span class="field-error" id="email-error" role="alert"><%= errors.email %></span><% } %>
        </div>

        <!-- Password -->
        <div class="form-group">
          <label for="password" class="form-label">Password</label>
          <div class="input-with-toggle">
            <input
              type="password"
              id="password"
              name="password"
              class="form-control<%= locals.errors?.password ? ' is-invalid' : '' %>"
              placeholder="Enter your password"
              required
              autocomplete="current-password"
              aria-describedby="<%= locals.errors?.password ? 'password-error' : '' %>"
            >
            <button type="button" class="toggle-password" aria-label="Show password" aria-pressed="false"><svg class="icon-eye" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="icon-eye-off" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><path d="M6.61 6.61A18.5 18.5 0 0 0 1 12s4 8 11 8a9.26 9.26 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg></button>
          </div>
          <% if (locals.errors?.password) { %><span class="field-error" id="password-error" role="alert"><%= errors.password %></span><% } %>
        </div>

        <button type="submit" class="btn-primary btn-full" style="margin-top:0.5rem;">Authenticate &amp; Sign In</button>

        <div class="auth-links" style="text-align:center;margin-top:1rem;">
          <a href="/forgot-password" style="font-size:0.85rem;color:var(--color-text-muted);">Forgot your password?</a>
        </div>

      </form>

      <div class="auth-divider"><span>Instant Executive Sandbox Demos</span></div>
      <p style="margin-bottom:1rem;text-align:center;font-size:0.85rem;color:var(--color-text-muted);">Explore each role's live operational console with pre-populated sample data.</p>

      <div class="demo-login-grid">
        <a href="/auth/demo/worker" class="demo-pill-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          <span>Labor Portal</span>
        </a>
        <a href="/auth/demo/business" class="demo-pill-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <span>Business Portal</span>
        </a>
        <a href="/auth/demo/prime" class="demo-pill-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <span>Prime Console</span>
        </a>
      </div>

      <div class="auth-divider"><span>Initialize a New Account</span></div>

      <div class="auth-register-links">
        <a href="/labor/register" class="btn btn-outline btn-sm">Skilled Worker</a>
        <a href="/business/register" class="btn btn-outline btn-sm">Small Business</a>
        <a href="/prime/register" class="btn btn-outline btn-sm">Prime Contractor</a>
      </div>

    </div>
  </div>
</section>
