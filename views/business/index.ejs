<% const title = locals.title || 'Business Portal' %>

<!-- Hero -->
<section class="wfc-hero">
  <div class="wfc-hero-inner">
    <span class="wfc-eyebrow">Business Portal</span>
    <h1>Your Certification<br>Opens Contract Doors.</h1>
    <p>Small, disadvantaged, and certified businesses get discovered by prime contractors actively seeking qualified subcontractors and suppliers on government projects. Showcase your capabilities. Win more work.</p>
    <div class="wfc-hero-cta">
      <a href="/business/register" class="btn-primary">Register Your Business</a>
      <a href="/login" class="btn-secondary-outline">Already a Member? Log In</a>
    </div>
  </div>
</section>

<!-- Certifications -->
<section class="wfc-section">
  <div class="wfc-section-inner">
    <div class="section-header text-center">
      <h2 class="section-title">Certification Types We Support</h2>
      <p class="section-subtitle">These certifications make your business eligible for set-aside contracts and required diversity spend commitments by prime contractors.</p>
    </div>
    <div class="cert-cards">
      <div class="cert-card">
        <div class="cert-badge">DBE</div>
        <h3>Disadvantaged Business Enterprise</h3>
        <p>Federally-funded transportation and infrastructure projects require DBE participation goals.</p>
      </div>
      <div class="cert-card">
        <div class="cert-badge">MBE</div>
        <h3>Minority Business Enterprise</h3>
        <p>Recognized by state and local agencies for diversity spend tracking and set-aside programs.</p>
      </div>
      <div class="cert-card">
        <div class="cert-badge">WBE</div>
        <h3>Women-Owned Business Enterprise</h3>
        <p>Qualifies for WOSB and EDWOSB federal set-asides and many prime diversity requirements.</p>
      </div>
      <div class="cert-card">
        <div class="cert-badge">HUB</div>
        <h3>Historically Underutilized Business</h3>
        <p>Texas state program with spending goals set at 11% for most state agencies.</p>
      </div>
      <div class="cert-card">
        <div class="cert-badge">SDVOSB</div>
        <h3>Service-Disabled Veteran-Owned</h3>
        <p>Federal set-aside program for veteran entrepreneurs with service-connected disabilities.</p>
      </div>
      <div class="cert-card">
        <div class="cert-badge">8(a)</div>
        <h3>SBA 8(a) Program</h3>
        <p>Nine-year business development program providing access to sole-source federal contracts.</p>
      </div>
      <div class="cert-card">
        <div class="cert-badge">SBE</div>
        <h3>Small Business Enterprise</h3>
        <p>State and local certifications recognizing qualifying small businesses for procurement preferences.</p>
      </div>
      <div class="cert-card">
        <div class="cert-badge">AABE</div>
        <h3>African American Business Enterprise</h3>
        <p>Recognized by participating agencies committed to AABE inclusion in contracting spend.</p>
      </div>
    </div>
  </div>
</section>

<!-- How It Works -->
<section class="wfc-section" style="background:#0B1220;">
  <div class="wfc-section-inner">
    <div class="section-header text-center">
      <h2 class="section-title">How the Business Portal Works</h2>
    </div>
    <div class="hiw-grid">
      <div class="hiw-card">
        <div class="hiw-step">01</div>
        <h3>Register &amp; Profile</h3>
        <p>Create your business profile with company info, NAICS codes, certifications, and service capabilities.</p>
      </div>
      <div class="hiw-card">
        <div class="hiw-step">02</div>
        <h3>Get Certified</h3>
        <p>Follow our certification checklist to achieve DBE, MBE, HUB, or other designations relevant to your market.</p>
      </div>
      <div class="hiw-card">
        <div class="hiw-step">03</div>
        <h3>Build Your Cap Statement</h3>
        <p>Use our built-in generator to create a professional capability statement — the #1 tool for winning sub work.</p>
      </div>
      <div class="hiw-card">
        <div class="hiw-step">04</div>
        <h3>Get Connected</h3>
        <p>Prime contractors search and connect with you when your NAICS codes and certifications match their project needs.</p>
      </div>
    </div>
  </div>
</section>

<!-- Benefits -->
<section class="wfc-section">
  <div class="wfc-section-inner">
    <div class="section-header text-center">
      <h2 class="section-title">Why Register on EvoConnect?</h2>
    </div>
    <div class="benefits-grid">
      <div class="benefit-card">
        <div class="benefit-icon">&#128269;</div>
        <h3>Be Found</h3>
        <p>Prime contractors search our verified business directory when they need certified subs for government projects.</p>
      </div>
      <div class="benefit-card">
        <div class="benefit-icon">&#128196;</div>
        <h3>Capability Statement Generator</h3>
        <p>Automatically generate a print-ready capability statement from your profile data — no design skills needed.</p>
      </div>
      <div class="benefit-card">
        <div class="benefit-icon">&#127919;</div>
        <h3>NAICS Matching</h3>
        <p>We map your services to NAICS codes and alert you when relevant contract opportunities are posted.</p>
      </div>
      <div class="benefit-card">
        <div class="benefit-icon">&#127942;</div>
        <h3>Certification Tracking</h3>
        <p>Track all your certifications in one place with expiration reminders and renewal guidance.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="wfc-cta-banner">
  <div class="wfc-cta-banner-inner">
    <h2 class="section-title">Ready to Get Found by Prime Contractors?</h2>
    <p>Register your business free. Build your profile. Start connecting.</p>
    <a href="/business/register" class="btn-white">Register Your Business</a>
  </div>
</section>
