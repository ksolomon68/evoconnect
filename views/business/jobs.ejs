<% locals.layout='layouts/dashboard'; %>
<%- include('../partials/flash') %>
<section class="hero-section"><div class="hero-content"><h1>Manage jobs</h1><p>Hire labor workers for your projects. Published jobs appear in the labor job board and automatic matches.</p></div></section>
<p><a class="btn btn-primary" href="/business/post-job">Post a job</a> <a class="btn btn-secondary" href="/business/job-applications">Review job applications</a></p>
<% if(!jobs.length) { %><p>You have not posted any jobs yet.</p><% } %>
<% for(const job of jobs) { %><article class="recommendations-list" style="padding:1.5rem;margin-top:1rem"><h2><a href="/jobs/<%= job.id %>"><%= job.title %></a></h2><p><%= job.status %> · <%= job.applications_count %> applications · <%= job.district_name %></p><p><%= job.scope_summary %></p><div style="display:flex;flex-wrap:wrap;gap:.5rem"><a class="btn btn-secondary" href="/business/jobs/<%= job.id %>/edit">Edit job</a><a class="btn btn-secondary" href="/business/opportunities/<%= job.id %>/matches">Find matching labor</a><a class="btn btn-secondary" href="/business/job-applications">Review applications</a><form method="post" action="/business/jobs/<%= job.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= job.status==='published'?'closed':'published' %>"><button class="btn btn-secondary"><%= job.status==='published'?'Close job':'Publish job' %></button></form><form method="post" action="/business/jobs/<%= job.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary">Archive</button></form></div></article><% } %>
