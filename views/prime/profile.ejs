<% const title = locals.title || 'Edit Profile' %>

<section class="profile-section">
  <div class="container">
    <div class="profile-header">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
        <div>
          <h1>Edit Company Profile</h1>
          <p class="section-sub">Keep your information up to date so workers and businesses can verify your credentials.</p>
        </div>
        <a href="/prime/dashboard" class="btn-sm btn-secondary">&larr; Dashboard</a>
      </div>
    </div>

    <%- include('../partials/flash') %>

    <!-- Tier Badge -->
    <% if (locals.prime) { %>
    <div style="margin-bottom:1.5rem;display:flex;align-items:center;gap:1rem">
      <span class="tier-badge tier-<%= prime.tier || 'basic' %>">
        <%= (prime.tier || 'basic').charAt(0).toUpperCase() + (prime.tier || 'basic').slice(1) %> Plan
      </span>
      <span class="text-muted" style="font-size:.875rem">
        Status: <%= prime.status === 'active' ? '✓ Approved' : prime.status === 'pending' ? '⏳ Pending Review' : '✗ Suspended' %>
      </span>
    </div>
    <% } %>

    <form method="POST" action="/prime/profile/update" class="profile-form" novalidate>

      <div class="form-card">
        <h2 class="form-card-title">Company Information</h2>

        <div class="form-group">
          <label for="company_name" class="form-label">Company Name <span class="required">*</span></label>
          <input type="text" id="company_name" name="company_name" class="form-control"
            value="<%= locals.prime?.company_name || '' %>" required autocomplete="organization">
        </div>

        <div class="form-group">
          <label for="contact_name" class="form-label">Primary Contact Name <span class="required">*</span></label>
          <input type="text" id="contact_name" name="contact_name" class="form-control"
            value="<%= locals.prime?.contact_name || '' %>" required autocomplete="name">
        </div>

        <div class="form-group">
          <label for="phone" class="form-label">Phone Number</label>
          <input type="tel" id="phone" name="phone" class="form-control"
            value="<%= locals.prime?.phone || '' %>" autocomplete="tel">
        </div>

        <div class="form-group">
          <label for="sam_uei" class="form-label">SAM.gov UEI</label>
          <input type="text" id="sam_uei" name="sam_uei" class="form-control"
            value="<%= locals.prime?.sam_uei || '' %>" maxlength="12" placeholder="12-character UEI">
          <small class="form-hint">Your Unique Entity Identifier from SAM.gov — required for approved accounts.</small>
        </div>

        <div class="form-group">
          <label for="contract_vehicles" class="form-label">Contract Vehicles</label>
          <input type="text" id="contract_vehicles" name="contract_vehicles" class="form-control"
            value="<%= locals.prime?.contract_vehicles || '' %>"
            placeholder="e.g., GSA Schedule 70, SEWP V, OASIS">
          <small class="form-hint">List the contract vehicles your company holds.</small>
        </div>
      </div>

      <div class="form-card">
        <h2 class="form-card-title">Location</h2>

        <div class="form-row">
          <div class="form-group">
            <label for="city" class="form-label">City</label>
            <input type="text" id="city" name="city" class="form-control"
              value="<%= locals.prime?.city || '' %>" autocomplete="address-level2">
          </div>
          <div class="form-group">
            <label for="state" class="form-label">State</label>
            <select id="state" name="state" class="form-control" autocomplete="address-level1">
              <option value="">-- Select --</option>
              <% (locals.states || []).forEach(function(s) { %>
              <option value="<%= s %>" <%= locals.prime?.state === s ? 'selected' : '' %>>
                <%= (locals.stateNames || {})[s] || s %>
              </option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="zip" class="form-label">ZIP Code</label>
            <input type="text" id="zip" name="zip" class="form-control" maxlength="10"
              value="<%= locals.prime?.zip || '' %>" autocomplete="postal-code">
          </div>
        </div>
      </div>

      <div class="form-card">
        <h2 class="form-card-title">NAICS Codes</h2>
        <p class="form-hint" style="margin-bottom:1rem">Add the NAICS codes relevant to your prime contracts to improve subcontractor matching.</p>

        <div id="naics-tags" class="tag-input-wrap">
          <% const naicsCodes = locals.prime?.naics_codes || [] %>
          <% if (Array.isArray(naicsCodes)) { naicsCodes.forEach(function(code) { %>
          <span class="tag" data-code="<%= code %>"><%= code %> <button type="button" class="tag-remove" aria-label="Remove <%= code %>">&times;</button></span>
          <% }) } %>
          <input type="text" id="naics-input" class="form-control" placeholder="Type a NAICS code and press Enter"
            style="flex:1;min-width:180px">
        </div>
        <input type="hidden" id="naics_codes_json" name="naics_codes_json"
          value="<%= JSON.stringify(Array.isArray(locals.prime?.naics_codes) ? locals.prime.naics_codes : []) %>">
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-primary">Save Changes</button>
        <a href="/prime/dashboard" class="btn-secondary-outline">Cancel</a>
      </div>

    </form>
  </div>
</section>

<script>
(function() {
  var tagsWrap  = document.getElementById('naics-tags');
  var naicsInput = document.getElementById('naics-input');
  var hiddenField = document.getElementById('naics_codes_json');
  var codes = <%= JSON.stringify(Array.isArray(locals.prime?.naics_codes) ? locals.prime.naics_codes : []) %>;

  function updateHidden() {
    hiddenField.value = JSON.stringify(codes);
  }

  function addCode(code) {
    code = code.trim().replace(/[^0-9]/g, '');
    if (!code || codes.includes(code)) return;
    codes.push(code);
    var tag = document.createElement('span');
    tag.className = 'tag';
    tag.dataset.code = code;
    tag.innerHTML = code + ' <button type="button" class="tag-remove" aria-label="Remove ' + code + '">&times;</button>';
    tag.querySelector('.tag-remove').addEventListener('click', function() {
      codes = codes.filter(function(c) { return c !== code; });
      tag.remove();
      updateHidden();
    });
    tagsWrap.insertBefore(tag, naicsInput);
    updateHidden();
  }

  naicsInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === ',') {
      e.preventDefault();
      addCode(naicsInput.value);
      naicsInput.value = '';
    }
  });

  document.querySelectorAll('.tag-remove').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var code = btn.closest('.tag').dataset.code;
      codes = codes.filter(function(c) { return c !== code; });
      btn.closest('.tag').remove();
      updateHidden();
    });
  });
})();
</script>
