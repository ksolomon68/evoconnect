<% const title = locals.title || 'Prime Contractor Portal' %>

<!-- Hero -->
<section class="wfc-hero">
  <div class="wfc-hero-inner">
    <span class="wfc-eyebrow">Prime Contractor Portal</span>
    <h1>Your Diversity Pipeline.<br>Built and Ready.</h1>
    <p>EvoConnect gives prime contractors and GCs instant access to a searchable directory of pre-profiled, certified subcontractors, small businesses, and skilled workers — all built for government contract compliance.</p>
    <div class="wfc-hero-cta">
      <a href="/prime/register" class="btn-amber">Get Started</a>
      <a href="/login" class="btn-secondary-outline">Already a Member? Log In</a>
    </div>
  </div>
</section>

<!-- Why Prime Contractors Choose EvoConnect -->
<section class="wfc-section">
  <div class="wfc-section-inner">
    <div class="section-header text-center">
      <h2 class="section-title">Built for Primes Who Need to Move Fast</h2>
      <p class="section-subtitle">Government projects have diversity requirements, short timelines, and specific trade demands. EvoConnect delivers the workforce pipeline you need — searchable in seconds.</p>
    </div>
    <div class="benefits-grid">
      <div class="benefit-card">
        <div class="benefit-icon">&#128269;</div>
        <h3>Verified Directories</h3>
        <p>Search workers and businesses by trade, certification type, NAICS code, location, and travel willingness.</p>
      </div>
      <div class="benefit-card">
        <div class="benefit-icon">&#127942;</div>
        <h3>Certification-Filtered Search</h3>
        <p>Find DBE, MBE, WBE, HUB, SDVOSB, and 8(a) certified subcontractors in seconds. Document your diversity spend.</p>
      </div>
      <div class="benefit-card">
        <div class="benefit-icon">&#128196;</div>
        <h3>Post RFQs (Enterprise)</h3>
        <p>Push Request for Qualifications directly to matched subcontractors and workers in your project area.</p>
      </div>
      <div class="benefit-card">
        <div class="benefit-icon">&#128101;</div>
        <h3>Direct Connections</h3>
        <p>Send connection requests to workers and businesses. Once accepted, get their full contact info instantly.</p>
      </div>
    </div>
  </div>
</section>

<!-- Pricing Tiers -->
<section class="wfc-section" style="background:#0B1220;">
  <div class="wfc-section-inner">
    <div class="section-header text-center">
      <h2 class="section-title">Choose Your Plan</h2>
      <p class="section-subtitle">Simple, transparent pricing. No long-term contracts.</p>
    </div>
    <div class="pricing-grid">

      <!-- Basic -->
      <div class="pricing-card">
        <div class="pricing-tier">Basic</div>
        <div class="pricing-price"><span class="price-amount">$49</span><span class="price-period">/month</span></div>
        <p class="pricing-tagline">For smaller primes getting started with subcontractor outreach.</p>
        <ul class="pricing-features">
          <li>&#10003; Labor Directory access</li>
          <li>&#10003; Business Directory access</li>
          <li>&#10003; Up to 10 connection requests/month</li>
          <li>&#10003; Filter by trade &amp; location</li>
          <li>&#10003; Filter by SAM.gov status</li>
          <li class="disabled">&#215; RFQ posting</li>
          <li class="disabled">&#215; Certification filtering</li>
          <li class="disabled">&#215; Unlimited connections</li>
        </ul>
        <a href="/prime/register?tier=basic" class="btn-secondary btn-full">Get Started</a>
      </div>

      <!-- Pro -->
      <div class="pricing-card pricing-featured">
        <div class="pricing-best-value">Most Popular</div>
        <div class="pricing-tier">Pro</div>
        <div class="pricing-price"><span class="price-amount">$149</span><span class="price-period">/month</span></div>
        <p class="pricing-tagline">For active primes who need certified sub pipelines on multiple projects.</p>
        <ul class="pricing-features">
          <li>&#10003; Everything in Basic</li>
          <li>&#10003; Unlimited connection requests</li>
          <li>&#10003; Certification filtering (DBE, MBE, HUB, etc.)</li>
          <li>&#10003; NAICS code search</li>
          <li>&#10003; Export contact lists</li>
          <li>&#10003; Priority support</li>
          <li class="disabled">&#215; RFQ posting</li>
          <li class="disabled">&#215; Dedicated account manager</li>
        </ul>
        <a href="/prime/register?tier=pro" class="btn-primary btn-full">Get Started</a>
      </div>

      <!-- Enterprise -->
      <div class="pricing-card">
        <div class="pricing-tier">Enterprise</div>
        <div class="pricing-price"><span class="price-amount">$399</span><span class="price-period">/month</span></div>
        <p class="pricing-tagline">For large primes and GCs managing major government contract portfolios.</p>
        <ul class="pricing-features">
          <li>&#10003; Everything in Pro</li>
          <li>&#10003; RFQ posting to matched subs</li>
          <li>&#10003; Multiple team seats</li>
          <li>&#10003; Dedicated account manager</li>
          <li>&#10003; Custom NAICS/project reporting</li>
          <li>&#10003; API access (coming soon)</li>
          <li>&#10003; White-glove onboarding</li>
        </ul>
        <a href="/prime/register?tier=enterprise" class="btn-amber btn-full">Get Started</a>
      </div>

    </div>
  </div>
</section>

<!-- CTA -->
<section class="wfc-cta-banner">
  <div class="wfc-cta-banner-inner">
    <h2 class="section-title">Ready to Build Your Sub Pipeline?</h2>
    <p>Join EvoConnect and start finding qualified, certified subcontractors today.</p>
    <a href="/prime/register" class="btn-amber btn-lg">Register as Prime Contractor</a>
  </div>
</section>
