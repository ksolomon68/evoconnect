<% const title = locals.title || 'Prime Contractor Dashboard' %>

<%
const connList = locals.connections || [];
const rfqList = locals.rfqs || [];
const oppsCount = locals.myOppsCount ?? rfqList.length;
const totalSubcontractors = locals.totalDirectoryCount ?? 0;
const pendingApps = locals.pendingAppsCount ?? connList.filter(c => c.status === 'pending').length;
const acceptedConns = connList.filter(c => c.status === 'accepted').length;
%>

<%- include('../partials/flash') %>

<!-- Executive Command Center Hero -->
<section class="hero-section evo-dashboard-hero" data-gsap="hero-banner">
    <div class="hero-content hero-welcome">
        <div class="wfc-eyebrow">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            <span>Prime Contractor Enterprise Console</span>
        </div>
        <h1>Prime Contractor <span>Sourcing Hub</span></h1>
        <p>Welcome, <%= prime.company_name || prime.contact_name || 'Prime Partner' %>! Streamline good-faith diversity outreach, evaluate RFQ bids from certified small businesses, and audit DBE/HUB participation goals.</p>
        <div class="hero-telemetry-chips">
            <span class="telemetry-chip"><span class="chip-dot chip-success"></span> Tier: <%= prime.tier ? prime.tier.toUpperCase() : 'ENTERPRISE' %></span>
            <span class="telemetry-chip"><span class="chip-dot chip-cyan"></span> UEI Status: Verified</span>
            <span class="telemetry-chip"><span class="chip-dot chip-info"></span> Directory: <%= totalSubcontractors %> Subcontractors</span>
        </div>
    </div>
</section>

<!-- Account Status Banner -->
<% if (prime.status === 'pending') { %>
<div class="banner banner-warning" style="margin-bottom:var(--space-lg);">
    <strong>Account Under Review.</strong> Your registration is being reviewed by our team. You'll receive an email once approved. Typical review time: 1–2 business days.
</div>
<% } else if (prime.status === 'active') { %>
<div id="welcomeBanner" style="margin-bottom:var(--space-lg);border-radius:var(--border-radius-lg);padding:var(--space-md) var(--space-lg);background:linear-gradient(135deg,#e8f4fd,#f0f9ff);border-left:4px solid var(--color-primary);display:flex;align-items:center;gap:var(--space-md);">
    <span style="font-size:1.5rem;">👋</span>
    <div style="flex:1;font-weight:500;color:var(--color-text-primary);">
        <strong>Account Active</strong> (<%= prime.tier ? prime.tier.charAt(0).toUpperCase() + prime.tier.slice(1) : 'Basic' %> Plan) —
        <% if (pendingApps > 0) { %>
            You have <strong><%= pendingApps %> pending connection/application<%= pendingApps > 1 ? 's' : '' %></strong> waiting for review.
        <% } else { %>
            Get started by <a href="/prime/post-rfq" style="color:var(--color-primary);font-weight:700;">posting a Request for Qualifications</a> or searching the directory.
        <% } %>
    </div>
    <button onclick="this.parentElement.style.display='none'" style="background:none;border:none;cursor:pointer;color:var(--text-muted);font-size:1.2rem;padding:0 0.25rem;" aria-label="Dismiss">&times;</button>
</div>
<% } else if (prime.status === 'suspended') { %>
<div class="banner banner-error" style="margin-bottom:var(--space-lg);">
    <strong>Account Suspended.</strong> Please contact <a href="mailto:ks@evobrand.net">ks@evobrand.net</a> for assistance.
</div>
<% } %>

<!-- Summary Cards (Stats Grid) -->
<section class="quick-stats">
    <div class="summary-grid">
        <div class="summary-card spotlight-card primary">
            <div class="summary-card-top">
                <span class="summary-label">Active RFQs</span>
                <span class="summary-icon">📂</span>
            </div>
            <div class="summary-value"><%= oppsCount %></div>
            <div class="summary-footer">
                <span class="trend-badge trend-success">● Published solicitations</span>
            </div>
        </div>

        <div class="summary-card spotlight-card success">
            <div class="summary-card-top">
                <span class="summary-label">Subcontractor Directory</span>
                <span class="summary-icon">🏢</span>
            </div>
            <div class="summary-value"><%= totalSubcontractors %></div>
            <div class="summary-footer">
                <span class="trend-badge trend-neutral">Verified DBE/HUB firms</span>
            </div>
        </div>

        <div class="summary-card spotlight-card <%= pendingApps > 0 ? 'warning' : 'primary' %>">
            <div class="summary-card-top">
                <span class="summary-label">Pending Applications</span>
                <span class="summary-icon">📋</span>
            </div>
            <div class="summary-value"><%= pendingApps %></div>
            <div class="summary-footer">
                <span class="trend-badge <%= pendingApps > 0 ? 'trend-warning' : 'trend-success' %>">
                    <%= pendingApps > 0 ? '● Proposals await evaluation' : '✓ All bids reviewed' %>
                </span>
            </div>
        </div>

        <div class="summary-card spotlight-card success">
            <div class="summary-card-top">
                <span class="summary-label">Active Partnerships</span>
                <span class="summary-icon">🤝</span>
            </div>
            <div class="summary-value"><%= acceptedConns %></div>
            <div class="summary-footer">
                <span class="trend-badge trend-success">● Subcontractor network</span>
            </div>
        </div>
    </div>
</section>

<!-- Quick Actions (Caltrans Action Grid) -->
<section class="action-section">
    <div class="section-header">
        <h2>🚀 Quick Actions</h2>
    </div>
    <div class="action-grid">
        <a href="/prime/post-rfq" class="action-card spotlight-card">
            <div class="action-card-header">
                <div class="icon-box">📝</div>
                <span class="action-card-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <h3>Post RFQ / Solicitation</h3>
            <p>Publish targeted subcontracting scopes matching 58 federal NAICS codes.</p>
        </a>
        <a href="/prime/opportunities" class="action-card spotlight-card">
            <div class="action-card-header">
                <div class="icon-box">📋</div>
                <span class="action-card-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <h3>Manage RFQs</h3>
            <p>Review proposal submissions, update milestones, and manage active scopes.</p>
        </a>
        <a href="/prime/applications" class="action-card spotlight-card">
            <div class="action-card-header">
                <div class="icon-box">📂</div>
                <span class="action-card-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <h3>View Applications</h3>
            <p>Evaluate subcontractor capabilities, pricing proposals, and award contract scopes.</p>
        </a>
        <a href="/prime/search/businesses" class="action-card spotlight-card">
            <div class="action-card-header">
                <div class="icon-box">🏢</div>
                <span class="action-card-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <h3>Search Small Businesses</h3>
            <p>Discover certified DBE, HUB, 8(a), WBE, and SDVOSB subcontractors by NAICS code.</p>
        </a>
        <a href="/prime/search/businesses?invite=true" class="action-card spotlight-card">
            <div class="action-card-header">
                <div class="icon-box">✉️</div>
                <span class="action-card-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <h3>Invite to Bid</h3>
            <p>Send direct RFQ invitations to pre-screened subcontractors for good-faith compliance.</p>
        </a>
        <a href="/prime/analytics" class="action-card spotlight-card">
            <div class="action-card-header">
                <div class="icon-box">📈</div>
                <span class="action-card-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <h3>Diversity Analytics</h3>
            <p>Monitor outreach compliance metrics, bidding rates, and subcontracting goal attainment.</p>
        </a>
        <a href="/prime/resources" class="action-card spotlight-card">
            <div class="action-card-header">
                <div class="icon-box">📚</div>
                <span class="action-card-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <h3>Resource Library</h3>
            <p>Access federal set-aside regulations, prompt pay standards, and procurement templates.</p>
        </a>
        <a href="/prime/settings" class="action-card spotlight-card">
            <div class="action-card-header">
                <div class="icon-box">⚙️</div>
                <span class="action-card-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <h3>Prime Settings</h3>
            <p>Update SAM UEI verification, subscription tier, and corporate dispatch preferences.</p>
        </a>
    </div>
</section>

<!-- Directory Search & RFQs & Connections -->
<div class="dashboard-grid" style="margin-top: var(--space-xl);">

    <!-- Search Panel: Business -->
    <div class="dash-card">
        <div class="dash-card-header">
            <h2>Quick Search: Business Directory</h2>
            <a href="/prime/search/businesses" class="btn-sm btn-primary">Open Search</a>
        </div>
        <form method="GET" action="/prime/search/businesses" class="quick-search-form">
            <div class="form-group">
                <label for="qs-cert" class="form-label">Certification</label>
                <select id="qs-cert" name="certifications" class="form-control">
                    <option value="">All certifications</option>
                    <option value="DBE">DBE</option>
                    <option value="MBE">MBE</option>
                    <option value="WBE">WBE</option>
                    <option value="HUB">HUB</option>
                    <option value="SDVOSB">SDVOSB</option>
                    <option value="8a">SBA 8(a)</option>
                </select>
            </div>
            <div class="form-group">
                <label for="qs-naics" class="form-label">NAICS Code</label>
                <input type="text" id="qs-naics" name="naics_code" class="form-control" placeholder="e.g. 237130">
            </div>
            <button type="submit" class="btn-primary btn-sm">Search Businesses</button>
        </form>
    </div>

    <!-- My RFQs -->
    <div class="dash-card dash-wide">
        <div class="dash-card-header">
            <h2>Requests for Qualifications</h2>
            <a href="/prime/opportunities" class="btn-sm btn-primary">Manage RFQs</a>
        </div>
        <% if (rfqList.length > 0) { %>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Project</th>
                        <th>Trade / Service</th>
                        <th>Location</th>
                        <th>Timeline</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% rfqList.forEach(function(rfq) { %>
                    <tr>
                        <td><strong><%= rfq.title %></strong></td>
                        <td><%= rfq.trade_service || '—' %></td>
                        <td><%= rfq.location || '—' %></td>
                        <td><%= rfq.timeline || '—' %></td>
                        <td><span class="badge badge-success"><%= rfq.status %></span></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <div class="empty-state">
                <p>No RFQs posted yet. <a href="/prime/post-rfq">Post a Request for Qualifications</a>.</p>
            </div>
        <% } %>
    </div>

    <!-- Connection History -->
    <div class="dash-card dash-wide">
        <div class="dash-card-header">
            <h2>Recent Connections</h2>
            <a href="/prime/connections" class="btn-sm">View All (<%= connList.length %>)</a>
        </div>
        <% if (connList.length > 0) { %>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name / Company</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% connList.slice(0, 8).forEach(function(conn) { %>
                    <tr>
                        <td><%= conn.target_name || conn.name || conn.company_name || '—' %></td>
                        <td><span class="badge badge-<%= conn.target_type === 'worker' ? 'cyan' : 'amber' %>"><%= conn.target_type %></span></td>
                        <td><span class="badge badge-<%= conn.status === 'accepted' ? 'success' : (conn.status === 'pending' ? 'warning' : 'muted') %>"><%= conn.status %></span></td>
                        <td><%= new Date(conn.created_at).toLocaleDateString() %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <div class="empty-state">
                <p>No connections yet. Start searching the <a href="/prime/search/businesses">Business Directory</a>.</p>
            </div>
        <% } %>
    </div>

</div>
