<% const title = locals.title || 'Review Applications | EVOGovCon Prime' %>
<% const appList = locals.applications || [] %>

<%- include('../partials/flash') %>

<section class="hero-section">
    <div class="hero-content hero-welcome">
        <h1>📥 <%= user.type==='business'?'Job Applications':'Submitted Applications' %></h1>
        <p><%= user.type==='business'?'Review labor applications for your jobs.':'Review applications from small businesses and subcontractors.' %></p>
    </div>
</section>

<div class="recommendations-list" style="padding: var(--space-xl);">
    <div class="section-header">
        <h2>Received Applications (<%= appList.length %>)</h2>
        <a href="<%= locals.basePath || '/prime' %>/<%= user.type==='business'?'jobs':'opportunities' %>" class="btn btn-sm btn-secondary"><%= user.type==='business'?'Manage Jobs':'Manage RFQs' %></a>
    </div>

    <% if (appList.length > 0) { %>
        <div style="overflow-x:auto;">
            <table class="data-table dashboard-record-list role-workflow-table" style="width:100%;">
                <thead>
                    <tr>
                        <th>Applicant</th>
                        <th>Type</th>
                        <th><%= user.type==='business'?'Job':'Opportunity' %></th>
                        <th><%= user.type==='business'?'Proposed rate':'Proposed bid' %></th>
                        <th>Notes / Summary</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% appList.forEach(function(app) { %>
                    <tr>
                        <td title="<%= app.applicant_name || 'Vendor' %>" class="data-table-title" data-label="Applicant">
                            <strong><%= app.applicant_name || 'Vendor' %></strong>
                            <% if (app.applicant_email) { %><div><a href="mailto:<%= app.applicant_email %>" style="font-size:0.8rem;color:var(--color-primary);"><%= app.applicant_email %></a></div><% } %>
                        <p><a href="/directory/<%= app.applicant_type %>/<%= app.applicant_id %>">Profile &amp; capability statement</a></p></td>
                        <td data-label="Type" style="text-transform:capitalize;"><%= app.applicant_type %></td>
                        <td data-label="<%= user.type==='business'?'Job':'Opportunity' %>"><strong><%= app.opportunity_title %></strong></td>
                        <td data-label="<%= user.type==='business'?'Proposed rate':'Proposed bid' %>"><%= app.proposed_amount || (app.notes || '').match(/^\[Proposed: ([^\]]+)\]/)?.[1] || 'Not provided' %></td>
                        <td data-label="Notes / Summary" style="max-width:260px;font-size:0.85rem;"><%= app.notes || '—' %></td>
                        <td data-label="Status">
                            <span class="status-badge <%= app.status === 'awarded' ? 'badge-consulting' : (app.status === 'declined' ? 'badge-construction' : 'badge-consulting') %>" style="text-transform:capitalize;margin:0;">
                                <%= (app.status || 'submitted').replace('_', ' ') %>
                            </span>
                        </td>
                        <td class="data-table-actions" data-label="Action" style="white-space:nowrap;">
                            <form method="POST" action="<%= locals.basePath || "/prime" %>/applications/<%= app.id %>/status" class="application-review-actions">
                                <select name="status" class="form-control" style="padding:0.25rem 0.5rem;font-size:0.8rem;width:auto;">
                                    <option value="approved" <%= app.status === 'approved' ? 'selected' : '' %>>Approved</option>
                                    <option value="under_review" <%= app.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
                                    <option value="awarded" <%= app.status === 'awarded' ? 'selected' : '' %>>Awarded</option>
                                    <option value="declined" <%= app.status === 'declined' ? 'selected' : '' %>>Declined</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div style="padding:2.5rem;text-align:center;color:var(--text-muted);">
            <p>No applications received yet. Invite qualified businesses or workers from your directory search!</p>
        </div>
    <% } %>
</div>

