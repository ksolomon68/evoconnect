<% locals.layout = 'layouts/dashboard'; const isRfq=user.type==='prime'; const isJob=opp.listing_type==='job' || user.type==='business'; const collection=user.type==='business'?'jobs':'opportunities'; %>
<section class="hero-section"><div class="hero-content"><h1><%= opp.id ? (isJob?'Edit job':(isRfq?'Edit Request for Qualifications':'Edit opportunity')) : (isJob?'Post a job':(isRfq?'Request for Qualifications (RFQ)':'Create opportunity')) %></h1><p><%= isRfq ? 'Describe the work, required qualifications, and deadline so small businesses can submit their qualifications.' : 'Describe the work, qualifications, and deadline so applicants can apply.' %></p></div></section>
<section class="recommendations-list" style="padding:var(--space-xl)">
<% if(error) { %><p role="alert" class="alert alert-error"><%= error %></p><% } %>
<form method="post" action="<%= basePath %>/<%= opp.id ? collection+'/'+encodeURIComponent(opp.id)+'/edit' : (isJob && user.type==='business'?'post-job':(isRfq?'post-rfq':'post-opportunity')) %>" style="display:grid;gap:1rem">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% const fields=[['title','Title',255,true],['category','Work category',100,true],['district_name','Location / service area',100,true],['estimated_value',isJob?'Pay / compensation':'Estimated contract value',100,false],['naics_codes','NAICS codes (comma separated)',1000,false],['certifications','Certifications preferred',5000,false],['submission_method','Submission instructions',255,false]]; %>
<% for(const [name,label,max,required] of fields) { let value=opp[name] || ''; if(name==='naics_codes') { try {const parsed=JSON.parse(value);if(Array.isArray(parsed))value=parsed.join(', ');}catch{} } %>
<div><label for="<%= name %>"><%= label %><%= required ? ' *' : '' %></label><input class="form-control" id="<%= name %>" name="<%= name %>" value="<%= value %>" maxlength="<%= max %>" <%= required ? 'required' : '' %>></div><% } %>
<div><label for="scope_summary"><%= isJob?'Job description':'Scope of work' %> *</label><textarea class="form-control" id="scope_summary" name="scope_summary" rows="6" maxlength="20000" required><%= opp.scope_summary || '' %></textarea></div>
<div><label for="requirements">Experience, insurance, and other requirements</label><textarea class="form-control" id="requirements" name="requirements" rows="3" maxlength="10000"><%= opp.requirements || '' %></textarea></div>
<div><label for="due_date">Application deadline (UTC)</label><input class="form-control" id="due_date" type="date" name="due_date" value="<%= (opp.due_date || '').slice(0,10) %>"></div>
<div><label for="due_time">Deadline time (UTC, optional)</label><input class="form-control" id="due_time" type="time" name="due_time" value="<%= opp.due_time || '' %>"></div>
<% if(user.type==='admin' && !opp.id) { %><div><label for="listing_type">Listing type</label><select class="form-control" id="listing_type" name="listing_type"><option value="opportunity">Opportunity for small businesses</option><option value="job">Job for labor workers</option></select></div><% } %>
<div><label for="status">Publication status</label><select class="form-control" id="status" name="status"><% for(const status of (isJob?['draft','published','closed','awarded','archived']:['draft','pending','published','closed','awarded','archived'])) { %><option value="<%= status %>" <%= (opp.status || (user.type === 'prime' ? 'pending' : 'draft')) === status ? 'selected' : '' %>><%= status %></option><% } %></select></div>
<button class="btn btn-primary"><%= isJob?'Save job':(isRfq?'Save RFQ':'Save opportunity') %></button><a href="<%= basePath %>/<%= collection %>">Cancel</a></form></section>
<% if(opp.id) { %><section class="recommendations-list" style="padding:var(--space-xl)"><h2><%= isJob?'Job attachments':'Solicitation attachments' %></h2><p>Upload supporting PDF specifications, up to 10 MB each.</p>
<% for(const file of locals.attachments || []) { %><p><a href="/opportunity-attachments/<%= file.id %>"><%= file.original_name %></a></p><form method="post" action="<%= basePath %>/opportunities/<%= encodeURIComponent(opp.id) %>/attachments/<%= file.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary">Remove attachment</button></form><% } %>
<form method="post" enctype="multipart/form-data" action="<%= basePath %>/opportunities/<%= encodeURIComponent(opp.id) %>/attachments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="attachment">PDF attachment</label><input id="attachment" type="file" name="statement" accept="application/pdf" required><button class="btn btn-primary">Add attachment</button></form></section><% } %>
