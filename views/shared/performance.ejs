<% locals.layout='layouts/dashboard'; const count=(entity,event)=>totals.filter(r=>r.entity_type===entity && r.event_type===event).reduce((sum,r)=>sum+Number(r.total),0); %>
<section class="hero-section"><div class="hero-content"><h1><%= platform ? 'Platform analytics' : 'My analytics' %></h1><p>See how your visibility turns into interest and applications.</p></div></section>
<section class="recommendations-list" style="padding:var(--space-xl)">
<form method="get"><label for="days">Reporting period</label><select name="days" id="days"><% for(const n of [7,30,90]) { %><option value="<%= n %>" <%= days===n ? 'selected' : '' %>>Last <%= n %> days</option><% } %></select> <button class="btn btn-secondary">Update</button></form>
<p>All dates use UTC. Views and downloads count each signed-in viewer once per item per day. Your own visits are excluded. Tracking starts when this feature is enabled; earlier activity is unavailable. <%= platform ? 'These totals cover all members.' : 'Only your own profile, documents, and postings are included.' %></p>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;margin:1.5rem 0">
<% for(const [label,value] of [['Profile views',count('profile','view')],['Statement views',count('capability','view')],['Statement downloads',count('capability','download')],['Opportunity views',count('opportunity','view')]]) { %><div class="stat-card"><h2><%= value %></h2><p><%= label %></p></div><% } %></div>
<% if(user.type!=='admin') { const type=user.type; %><p><a href="/directory/<%= type %>/<%= user.id %>" <%= type==='admin' ? 'hidden' : '' %>>View my directory profile</a> · <a href="<%= basePath %>/documents">Manage capability statement</a></p><% } %>
<h2>Capability statements</h2><% if(!documents.length) { %><div class="empty-state-inline"><p>No current uploaded statements. Views of removed or replaced statements remain included in the totals above.</p></div><% } else { %><div style="overflow:auto"><table class="data-table"><thead><tr><th>Document</th><th>Views</th><th>Downloads</th></tr></thead><tbody><% for(const doc of documents) { %><tr><td><a href="/capabilities/<%= doc.id %>"><%= doc.original_name %></a></td><td><%= doc.views %></td><td><%= doc.downloads %></td></tr><% } %></tbody></table></div><% } %>
<h2>Opportunity performance</h2><% if(!opps.length) { %><div class="empty-state-inline"><p>No owned opportunity postings. Applicant accounts track their submissions below.</p></div><% } else { %><div style="overflow:auto"><table class="data-table"><thead><tr><th>Opportunity</th><th>Status</th><th>Views</th><th>Saves</th><th>Applications</th><th>Applications / views</th></tr></thead><tbody><% for(const opp of opps) { %><tr><td><a href="/opportunities/<%= encodeURIComponent(opp.id) %>"><%= opp.title %></a></td><td><%= opp.status %></td><td><%= opp.views %></td><td><%= opp.saves %></td><td><%= opp.applications %></td><td><%= Number(opp.views)>0 ? (100*Number(opp.applications)/Number(opp.views)).toFixed(1)+'%' : '—' %></td></tr><% } %></tbody></table></div><p>Applications and saves reflect records created in this period. Applications / views is a ratio of those totals, not a count of unique converting visitors.</p><% } %>
<h2><%= platform ? 'Platform applications' : 'My application outcomes' %></h2><% if(!applications.length) { %><div class="empty-state-inline"><p>No applications submitted in this period.</p></div><% } else { %><ul><% for(const row of applications) { %><li><%= row.status.replaceAll('_',' ') %>: <%= row.total %></li><% } %></ul><% } %>
<h2>Daily activity</h2><% if(!daily.length) { %><div class="empty-state-inline"><p>No external views or downloads recorded in this period. Share your profile and publish opportunities to start measuring interest.</p></div><% } else { %><div style="overflow:auto"><table class="data-table"><thead><tr><th>Date (UTC)</th><th>Item</th><th>Action</th><th>Count</th></tr></thead><tbody><% for(const row of daily) { %><tr><td><%= row.day %></td><td><%= row.entity_type %></td><td><%= row.event_type %></td><td><%= row.total %></td></tr><% } %></tbody></table></div><% } %>
</section>
