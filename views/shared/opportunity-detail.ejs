<% locals.layout = 'layouts/dashboard'; %>
<section class="hero-section"><div class="hero-content"><h1><%= opp.title %></h1><p><%= opp.posted_by_name || 'EvoConnect' %> · <%= opp.status %></p></div></section>
<section class="recommendations-list" style="padding:var(--space-xl)"><dl><dt>Category</dt><dd><%= opp.category_name %></dd><dt>Location</dt><dd><%= opp.district_name %></dd><dt>Estimated value</dt><dd><%= opp.estimated_value || 'Not specified' %></dd><dt>Deadline (UTC)</dt><dd><%= opp.due_date || 'Open until filled' %> <%= opp.due_time || '' %></dd></dl>
<h2>Scope</h2><p style="white-space:pre-wrap"><%= opp.scope_summary %></p><h2>Requirements</h2><p style="white-space:pre-wrap"><%= opp.requirements || 'See scope of work.' %></p><p>Certifications: <%= opp.certifications || 'Not specified' %></p><p>Submission: <%= opp.submission_method || 'Online portal' %></p>
<% if(publisherProfile) { %><p><a href="/directory/prime/<%= publisherProfile.id %>">View contractor profile and capability statement</a></p><% } %>
<% if(['worker','business'].includes(user.type)) { %><a class="btn btn-primary" href="<%= basePath %>/search?q=<%= encodeURIComponent(opp.title) %>">Apply or save opportunity</a><% } %></section>
<section class="recommendations-list" style="padding:var(--space-xl)"><h2>Supporting documents</h2><% if(!attachments.length) { %><p>No attachments.</p><% } %><ul><% for(const file of attachments) { %><li><a href="/opportunity-attachments/<%= file.id %>"><%= file.original_name %> (PDF, <%= Math.ceil(file.size_bytes/1024) %> KB)</a></li><% } %></ul></section>
