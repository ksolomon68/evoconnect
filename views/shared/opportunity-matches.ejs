<% locals.layout='layouts/dashboard'; %><section class="hero-section"><div class="hero-content"><h1>Suggested partners</h1><p><%= opp.title %></p></div></section>
<section class="recommendations-list" style="padding:var(--space-xl)"><p>Matches update automatically from current NAICS codes. The percentage shows how many of the opportunity’s codes match the partner. Review qualifications, certifications, and availability before selecting a partner.</p><% if(!matches.length) { %><div class="empty-state-inline"><p>No matching active businesses or workers yet. Add NAICS codes to the opportunity or search the business directory.</p></div><% } %>
<% for(const partner of matches) { %><article class="card" style="padding:1rem;margin:1rem 0"><h2><a href="/directory/<%= partner.type %>/<%= partner.id %>"><%= partner.name %></a></h2><p><%= [partner.city,partner.state].filter(Boolean).join(', ') %> · <%= partner.type === 'worker' ? 'Worker' : 'Business' %> · <%= partner.score %>% code coverage · Matching NAICS: <%= partner.matched.join(', ') %></p><form method="post" action="<%= basePath %>/opportunities/<%= encodeURIComponent(opp.id) %>/invite"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="target_key" value="<%= partner.type %>:<%= partner.id %>"><button class="btn btn-primary">Invite to apply</button></form></article><% } %><a href="<%= basePath %>/<%= user.type==='business'?'jobs':'opportunities' %>">Back to opportunities</a></section>
