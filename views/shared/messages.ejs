<% const title = locals.title || 'Messages | EVOGovCon' %>
<% const basePath = locals.basePath || (locals.user?.type === 'business' ? '/business' : (locals.user?.type === 'prime' ? '/prime' : (locals.user?.type === 'admin' ? '/admin' : '/labor'))) %>
<% const inbox = locals.inbox || [] %>
<% const sent = locals.sent || [] %>
<% const recipients = locals.recipients || [] %>

<%- include('../partials/flash') %>

<section class="hero-section">
    <div class="hero-content hero-welcome">
        <h1>💬 Messages & Communications</h1>
        <p>Message accepted connections and platform support. Labor communicates with small businesses; small businesses communicate with labor and primes.</p>
        <% if (locals.supportRecipient) { %>
            <a class="btn btn-primary" href="<%= basePath %>/messages?recipient=<%= encodeURIComponent('admin:' + supportRecipient.id) %>#message-compose">Message EVOBRAND</a>
            <p>Contact the admin for account help, questions, or platform support. No connection request is needed.</p>
        <% } %>
    </div>
</section>

<div class="communications-grid">

    <!-- Compose Message -->
    <div id="message-compose" class="recommendations-list" style="padding: var(--space-xl);">
        <div class="section-header">
            <h2>✉️ Send New Message</h2>
        </div>
        <form method="POST" action="<%= basePath %>/messages/send"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group" style="margin-bottom:1rem;">
                <label for="message-recipient" style="display:block;font-weight:600;margin-bottom:.35rem;font-size:.9rem;">Recipient *</label>
                <select id="message-recipient" name="recipient_key" class="form-control" required>
                    <option value="">Select recipient...</option>
                    <% recipients.forEach(function(r) { %>
                        <option value="<%= r.type %>:<%= r.id %>" <%= locals.selectedRecipient === r.type + ':' + r.id ? 'selected' : '' %>><%= r.label %></option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group" style="margin-bottom:1rem;">
                <label for="message-subject" style="display:block;font-weight:600;margin-bottom:.35rem;font-size:.9rem;">Subject *</label>
                <input id="message-subject" type="text" name="subject" class="form-control" required maxlength="255" value="<%= locals.replySubject || '' %>" placeholder="e.g. Subcontracting Inquiry / RFQ Follow-up">
            </div>
            <div class="form-group" style="margin-bottom:1rem;">
                <label for="message-body" style="display:block;font-weight:600;margin-bottom:.35rem;font-size:.9rem;">Message *</label>
                <textarea id="message-body" name="body" rows="4" class="form-control" required maxlength="10000" placeholder="Write your message here..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Send Message</button>
        </form>
    </div>

    <!-- Inbox & Sent -->
    <div class="recommendations-list" style="padding: var(--space-xl);">
        <div class="section-header">
            <h2>📥 Inbox (<%= inbox.length %>)</h2>
        </div>
        <% if (inbox.length > 0) { %>
            <div class="message-list" style="display:grid;gap:0.75rem;margin-bottom:2rem;">
                <% inbox.forEach(function(msg) { %>
                <div class="message-card" style="padding:1rem;border:1px solid var(--border-color);border-radius:var(--border-radius-md);background:<%= msg.is_read ? '#fff' : '#f0f9ff' %>;">
                    <div class="message-heading">
                        <strong class="dashboard-list-title" title="<%= msg.subject || '(No Subject)' %>"><%= msg.subject || '(No Subject)' %></strong>
                        <span style="font-size:0.8rem;color:var(--text-muted);"><%= new Date(msg.created_at).toLocaleDateString() %></span>
                    </div>
                    <div style="font-size:0.85rem;color:var(--color-primary);margin-bottom:0.5rem;">
                        From: <%= msg.sender_name || msg.sender_type %>
                    </div>
                    <p style="margin:0;font-size:0.92rem;color:var(--color-text-secondary);white-space:pre-line;"><%= msg.body %></p>
                    <% if (msg.can_reply) { %>
                        <a class="btn btn-sm btn-secondary" style="margin-top:.75rem;" href="<%= basePath %>/messages?reply=<%= msg.id %>#message-compose">Reply</a>
                    <% } %>
                </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="empty-state-inline"><p>Your inbox is empty.</p></div>
        <% } %>

        <div class="section-header">
            <h2>📤 Sent Messages (<%= sent.length %>)</h2>
        </div>
        <% if (sent.length > 0) { %>
            <div class="message-list" style="display:grid;gap:0.75rem;">
                <% sent.forEach(function(msg) { %>
                <div class="message-card" style="padding:0.85rem;border:1px solid var(--border-color);border-radius:var(--border-radius-md);">
                    <div class="message-heading">
                        <strong class="dashboard-list-title" title="<%= msg.subject || '(No Subject)' %>"><%= msg.subject || '(No Subject)' %></strong>
                        <span style="font-size:0.8rem;color:var(--text-muted);"><%= new Date(msg.created_at).toLocaleDateString() %></span>
                    </div>
                    <div style="font-size:0.82rem;color:var(--text-muted);margin-bottom:0.35rem;">
                        To: <%= msg.receiver_name || msg.receiver_type %>
                    </div>
                    <p style="margin:0;font-size:0.88rem;color:var(--color-text-secondary);"><%= msg.body %></p>
                </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="empty-state-inline"><p>No sent messages yet.</p></div>
        <% } %>
    </div>

</div>

