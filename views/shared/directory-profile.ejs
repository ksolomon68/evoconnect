<section class="hero-section"><div class="hero-content"><h1><%= profile.name %></h1><p><%= profile.type === 'worker' ? 'Labor' : profile.type === 'prime' ? 'Prime contractor' : 'Small business' %> · <%= [profile.city,profile.state].filter(Boolean).join(', ') || 'Location not provided' %></p></div></section>
<section class="recommendations-list" style="padding:var(--space-xl)"><h2>Qualifications</h2><p style="white-space:pre-wrap"><%= profile.description || 'This member has not added a description yet.' %></p>
<% for(const field of ['naics','certifications']) { let list=[]; try {list=typeof profile[field]==='string'?JSON.parse(profile[field]):profile[field];} catch {} %>
<% if(Array.isArray(list) && list.length) { %><h3><%= field === 'naics' ? 'NAICS codes' : 'Certifications' %></h3><p><%= list.join(', ') %></p><% } %><% } %>
<h2>Capability statement</h2><% if(document) { %><p><a class="btn btn-primary" href="/capabilities/<%= document.id %>">View PDF</a> <a class="btn btn-secondary" href="/capabilities/<%= document.id %>?download=1">Download PDF</a></p><% } else { %><p>No uploaded capability statement.</p><% } %>
<p>Contact details are shared through EVOConnect connections and messages.</p></section>
