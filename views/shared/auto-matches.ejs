<% locals.layout='layouts/dashboard'; %>
<section class="hero-section"><div class="hero-content"><h1>Automatic NAICS matches</h1><p>Open opportunities matched to the NAICS codes on your profile.</p></div></section>
<section class="recommendations-list" style="padding:var(--space-xl)">
<p>Matches refresh whenever you visit, using your current profile and currently published, unexpired opportunities. No search filters are needed.</p>
<p>The percentage is the share of the opportunity’s NAICS codes that match yours exactly. It is not a qualification or award prediction. Review the scope, location, certifications, and requirements before applying.</p>
<% if(user.type==='worker') { %><details><summary>Update my NAICS matching codes</summary><form method="post" action="/labor/matches/codes"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="match-codes">NAICS codes, separated by commas</label><input class="form-control" id="match-codes" name="naics_codes" value="<%= result.codes.join(', ') %>"><button class="btn btn-primary">Update automatic matches</button></form><p>Available codes:</p><ul><% for(const row of directory) { %><li><%= row.code %> — <%= row.description %></li><% } %></ul></details><% } %>
<p>Your codes: <%= result.codes.join(', ') || 'None yet' %> · <a href="<%= basePath %>/profile">Update profile</a></p>
<% if(!result.codes.length) { %><p><%= user.type==='worker' ? 'Use Update my NAICS matching codes above to enable automatic matching.' : 'Add NAICS codes to your profile to enable automatic matching.' %></p><% } else if(!result.matches.length) { %><p>No matching open opportunities yet. New opportunities will appear here automatically when they match your codes.</p><% } %>
<% for(const match of result.matches) { %><article class="card" style="padding:1.25rem;margin:1rem 0"><h2><a href="/opportunities/<%= encodeURIComponent(match.id) %>"><%= match.title %></a></h2><p><strong><%= match.score %>% code coverage</strong> · Matching NAICS: <%= match.matched.join(', ') %></p><p><%= match.posted_by_name || 'EvoConnect' %> · <%= match.district_name %> · Deadline: <%= match.due_date || 'Open until filled' %></p><p><%= match.scope_summary.slice(0,300) %></p><a class="btn btn-primary" href="/opportunities/<%= encodeURIComponent(match.id) %>">View opportunity and apply</a></article><% } %>
</section>
