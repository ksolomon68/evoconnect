<% if(locals.user) locals.layout='layouts/dashboard'; %>
<section class="faq-section">
  <div class="container">
    <div class="section-header text-center">
      <h1>Frequently Asked Questions</h1>
      <p class="section-sub">Help for workers, small businesses, and prime contractors. No account is needed to read these answers.</p>
    </div>
    <nav class="faq-topics" aria-label="FAQ topics">
      <% for(const group of groups) { %><a href="#faq-<%= group.id %>"><%= group.title %></a><% } %>
    </nav>
    <% for(const group of groups) { %>
    <section class="faq-group" id="faq-<%= group.id %>" aria-labelledby="faq-title-<%= group.id %>">
      <h2 id="faq-title-<%= group.id %>"><%= group.title %></h2>
      <div class="faq-list">
        <% for(const faq of group.items) { %>
        <details class="faq-item">
          <summary class="faq-question"><%= faq.q %></summary>
          <div class="faq-answer"><p><%= faq.a %></p></div>
        </details>
        <% } %>
      </div>
    </section>
    <% } %>
    <div class="faq-cta text-center"><p>Still need help?</p><a href="/contact" class="btn-primary">Contact Support</a></div>
  </div>
</section>
