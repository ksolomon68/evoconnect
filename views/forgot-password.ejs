<% const title = locals.title || 'Forgot Password' %>

<section class="auth-section">
  <div class="container">
    <div class="auth-card">
      <a href="/" class="auth-logo" style="display:flex;align-items:center;justify-content:center;gap:0.65rem;margin-bottom:0.75rem;text-decoration:none;" aria-label="EVOConnected Home">
        <img src="/images/favicon.png" alt="EVOConnected" height="36" style="border-radius:8px;">
        <span style="font-family:var(--font-family-secondary, 'Plus Jakarta Sans', sans-serif);font-size:1.5rem;font-weight:800;letter-spacing:-0.02em;color:var(--color-text-primary, #F8FAFC);">EVO<span style="color:#06B6D4;">Connected</span></span>
      </a>
      <h1 class="auth-title">Reset Your Password</h1>
      <p class="auth-subtitle">Enter your email address and user type below. If an account exists, we'll send you a link to reset your password.</p>

      <%- include('partials/flash') %>

      <% if (!locals.flash || locals.flash.type !== 'success') { %>
      <form method="POST" action="/forgot-password" class="auth-form" novalidate>

        <!-- Email -->
        <div class="form-group">
          <label for="email" class="form-label">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control<%= locals.errors?.email ? ' is-invalid' : '' %>"
            value="<%= locals.values?.email || '' %>"
            required
            autocomplete="email"
            aria-describedby="<%= locals.errors?.email ? 'email-error' : '' %>"
          >
          <% if (locals.errors?.email) { %><span class="field-error" id="email-error" role="alert"><%= errors.email %></span><% } %>
        </div>

        <button type="submit" class="btn-primary btn-full">Send Reset Link</button>

        <div class="auth-links">
          <a href="/login">&larr; Back to Log In</a>
        </div>

      </form>
      <% } %>

    </div>
  </div>
</section>
