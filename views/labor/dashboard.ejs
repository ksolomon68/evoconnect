<%- locals.layout = 'layouts/dashboard'; %>
<% const title = locals.title || 'My Dashboard' %>

<%
const federalChecklist = [
  {key:'uei',            label:'Get your UEI (Unique Entity ID) at SAM.gov',           track:'federal'},
  {key:'sam_register',   label:'Complete SAM.gov registration',                          track:'federal'},
  {key:'sam_activate',   label:'Activate SAM.gov registration (7–10 days)',              track:'federal'},
  {key:'eft',            label:'Set up EFT (Electronic Funds Transfer) for payments',    track:'federal'},
  {key:'usa_spending',   label:'Verify your listing on USASpending.gov',                 track:'federal'},
  {key:'annual_renewal', label:'Set reminder for annual SAM.gov renewal',                track:'federal'},
  {key:'naics_verify',   label:'Verify your NAICS codes are correct in SAM.gov',         track:'federal'}
];
const stateChecklist = [
  {key:'hub_eligibility', label:'Check HUB certification eligibility',                   track:'state'},
  {key:'hub_apply',       label:'Apply for Texas HUB certification',                     track:'state'},
  {key:'hub_approved',    label:'HUB certification approved',                            track:'state'},
  {key:'state_vendor',    label:'Register on Texas SmartBuy vendor portal',              track:'state'},
  {key:'comptroller',     label:'Check Texas Comptroller vendor list',                   track:'state'}
];
const subChecklist = [
  {key:'business_entity', label:'Form a business entity (LLC, Sole Prop, etc.)',         track:'subcontractor'},
  {key:'ein',             label:'Obtain EIN from IRS.gov (free)',                        track:'subcontractor'},
  {key:'bank_account',    label:'Open a dedicated business bank account',                track:'subcontractor'},
  {key:'cap_statement',   label:'Create your Capability Statement',                      track:'subcontractor'},
  {key:'insurance',       label:'Get Certificate of Insurance (COI)',                    track:'subcontractor'},
  {key:'trade_license',   label:'Obtain required trade licenses for your state',         track:'subcontractor'},
  {key:'evo_profile',     label:'Complete your EvoConnect profile 100%',                 track:'subcontractor'}
];

const byTrack = locals.checklistByTrack || {};
const fedChecked   = byTrack.federal       || {};
const stateChecked = byTrack.state         || {};
const subChecked   = byTrack.subcontractor || {};

const connectionList = locals.connections || [];
const pendingConns = connectionList.filter(c => c.status === 'pending');
const naicsMatches = locals.matches || [];
const skillsArr = Array.isArray(worker.skills) ? worker.skills : [];
const pct = worker.profile_pct || 0;

// Total checklist completed calculation
const totalItems = federalChecklist.length + stateChecklist.length + subChecklist.length;
const totalDone = federalChecklist.filter(i => fedChecked[i.key]).length +
                  stateChecklist.filter(i => stateChecked[i.key]).length +
                  subChecklist.filter(i => subChecked[i.key]).length;
const checklistPct = Math.round((totalDone / totalItems) * 100) || 0;
%>

<%- include('../partials/flash') %>

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content hero-welcome">
        <h1>💼 Worker Dashboard</h1>
        <p>Welcome back, <%= worker.full_name ? worker.full_name.split(' ')[0] : 'there' %>! Track your business growth and discover new contracting opportunities.</p>
    </div>
</section>

<!-- Warm Notifications -->
<% if (pendingConns.length > 0) { %>
<div id="notificationBanner" style="margin-bottom:var(--space-lg);border-radius:var(--border-radius-lg);padding:var(--space-md) var(--space-lg);background:linear-gradient(135deg,#e8f4fd,#f0f9ff);border-left:4px solid var(--color-primary);display:flex;align-items:center;gap:var(--space-md);">
    <span style="font-size:1.5rem;">👋</span>
    <div style="flex:1;font-weight:500;color:var(--color-text-primary);">
        You have <strong><%= pendingConns.length %> pending connection request<%= pendingConns.length > 1 ? 's' : '' %></strong> from prime contractors. Review them below!
    </div>
    <button onclick="this.parentElement.style.display='none'" style="background:none;border:none;cursor:pointer;color:var(--text-muted);font-size:1.2rem;padding:0 0.25rem;" aria-label="Dismiss">&times;</button>
</div>
<% } else if (pct < 100) { %>
<div id="notificationBanner" style="margin-bottom:var(--space-lg);border-radius:var(--border-radius-lg);padding:var(--space-md) var(--space-lg);background:linear-gradient(135deg,#fffbf0,#fff4d6);border-left:4px solid var(--color-warning);display:flex;align-items:center;gap:var(--space-md);">
    <span style="font-size:1.5rem;">⚠️</span>
    <div style="flex:1;font-weight:500;color:var(--color-text-primary);">
        Your profile is only <strong><%= pct %>% complete</strong>. Complete your profile and checklist to maximize your visibility to prime contractors.
    </div>
    <button onclick="this.parentElement.style.display='none'" style="background:none;border:none;cursor:pointer;color:var(--text-muted);font-size:1.2rem;padding:0 0.25rem;" aria-label="Dismiss">&times;</button>
</div>
<% } %>

<!-- Summary Cards (Stats Grid) -->
<section class="quick-stats">
    <div class="summary-grid">
        <div class="summary-card primary">
            <div class="summary-value"><%= pct %>%</div>
            <div class="summary-label">Profile Completion</div>
        </div>
        <div class="summary-card <%= naicsMatches.length > 0 ? 'success' : 'primary' %>">
            <div class="summary-value"><%= naicsMatches.length %></div>
            <div class="summary-label">Matched Contracts</div>
        </div>
        <div class="summary-card <%= pendingConns.length > 0 ? 'warning' : 'primary' %>">
            <div class="summary-value"><%= pendingConns.length %></div>
            <div class="summary-label">Pending Connections</div>
        </div>
        <div class="summary-card success">
            <div class="summary-value"><%= checklistPct %>%</div>
            <div class="summary-label">Checklist Progress</div>
        </div>
    </div>
</section>

<!-- Action Grid (Quick Actions) -->
<section class="action-section">
    <div class="section-header">
        <h2>🚀 Quick Actions</h2>
    </div>
    <div class="action-grid">
        <a href="/labor/profile" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">👤</div>
            <h3>My Profile</h3>
            <p>Update your business information and skills.</p>
        </a>
        <a href="/labor/checklist" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">✅</div>
            <h3>Readiness Checklist</h3>
            <p>Complete steps to become government contract ready.</p>
        </a>
        <a href="/labor/resources" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">📚</div>
            <h3>Resources</h3>
            <p>Access templates and guides for your business.</p>
        </a>
        <a href="/labor/faq" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">❓</div>
            <h3>Help & FAQ</h3>
            <p>Get answers to common contracting questions.</p>
        </a>
    </div>
</section>

<!-- Main Details -->
<div class="dashboard-grid" style="display: grid; grid-template-columns: 1fr; gap: var(--space-xl); margin-top: var(--space-xl);">
    
    <!-- Connection Requests -->
    <div class="recommendations-list" style="padding: var(--space-xl);">
        <div class="section-header">
            <h2>Connection Requests</h2>
            <% if (pendingConns.length > 0) { %>
                <span class="status-badge badge-consulting"><%= pendingConns.length %> pending</span>
            <% } %>
        </div>
        <% if (pendingConns.length > 0) { %>
            <ul class="connection-list" style="list-style: none; padding: 0;">
            <% pendingConns.forEach(function(conn) { %>
            <li class="recommendation-item">
                <div class="rec-info">
                <h4><%= conn.prime_company_name || conn.prime_company || 'Prime Contractor' %></h4>
                <% if (conn.message) { %><p class="rec-meta"><%= conn.message %></p><% } %>
                <span class="rec-meta" style="font-size: 0.8rem;"><%= new Date(conn.created_at).toLocaleDateString() %></span>
                </div>
                <div class="rec-value">
                <form method="POST" action="/labor/connections/<%= conn.id %>" style="display:inline">
                    <input type="hidden" name="action" value="accept">
                    <button type="submit" class="btn btn-sm btn-primary" style="margin-right: 8px;">Accept</button>
                </form>
                <form method="POST" action="/labor/connections/<%= conn.id %>" style="display:inline">
                    <input type="hidden" name="action" value="decline">
                    <button type="submit" class="btn btn-sm btn-secondary">Decline</button>
                </form>
                </div>
            </li>
            <% }) %>
            </ul>
        <% } else { %>
            <div style="color: var(--text-muted); text-align: center; padding: var(--space-lg);">
                <p>No pending connection requests. Complete your profile and checklist to increase visibility.</p>
            </div>
        <% } %>
    </div>

    <!-- Matched Contracts -->
    <div class="recommendations-list" style="padding: var(--space-xl);">
        <div class="section-header">
            <h2>My Matched Contracts</h2>
            <span class="status-badge badge-consulting">NAICS Matched</span>
        </div>
        <% if (naicsMatches.length > 0) { %>
            <div class="match-list" style="display: grid; gap: 1rem;">
            <% naicsMatches.forEach(function(match) { %>
            <div class="recommendation-item">
                <div class="rec-info">
                    <h4><span style="color: var(--color-primary); margin-right: 0.5rem;">[<%= match.naics_code %>]</span> <%= match.description %></h4>
                    <% if (match.avg_contract_size) { %>
                        <span class="rec-meta">Avg. contract: <%= match.avg_contract_size %></span>
                    <% } %>
                </div>
                <div class="rec-value">
                    <% if (match.set_aside_eligible) { %>
                        <span class="status-badge badge-construction" style="margin:0;">Set-Aside Eligible</span>
                    <% } %>
                </div>
            </div>
            <% }) %>
            </div>
        <% } else { %>
            <div style="color: var(--text-muted); text-align: center; padding: var(--space-lg);">
                <p>No NAICS matches yet. <a href="/labor/profile" style="color: var(--color-primary);">Update your trade category</a> to get matched to contract opportunities.</p>
            </div>
        <% } %>
    </div>
</div>
