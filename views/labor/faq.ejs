<% const title = locals.title || 'Labor Portal FAQ' %>

<section class="faq-section">
  <div class="container">
    <div class="section-header text-center">
      <div class="hero-badge">Labor Portal</div>
      <h1>Frequently Asked Questions</h1>
      <p class="section-sub">Everything you need to know about getting started as a worker on EVOGovCon.</p>
    </div>

    <%- include('../partials/flash') %>

    <p class="faq-browse"><a href="/faq">Browse FAQs for all EVOGovCon members</a></p>
    <div class="faq-list">

      <% if (locals.faqs && faqs.length > 0) { %>
        <% faqs.forEach(function(faq) { %>
          <details class="faq-item">
            <summary class="faq-question"><%= faq.q %></summary>
            <div class="faq-answer">
              <%- faq.a %>
            </div>
          </details>
        <% }) %>
      <% } else { %>
        <p>No FAQs available at this time.</p>
      <% } %>

    </div>

    <div class="faq-cta text-center">
      <p>Have a question that isn't answered here?</p>
      <a href="/contact" class="btn-primary">Contact Support</a>
    </div>
  </div>
</section>
