<% const title = locals.title || 'Labor Portal' %>

<!-- Executive Hero -->
<section class="wfc-hero evo-role-hero">
  <div class="evo-grid-backdrop" aria-hidden="true"></div>
  <div class="shape shape-1" aria-hidden="true"></div>
  <div class="shape shape-2" aria-hidden="true"></div>
  <div class="wfc-hero-inner">
    <div class="wfc-eyebrow" data-gsap="hero-eyebrow">
      <span class="eyebrow-dot" aria-hidden="true"></span>
      <span>DIVISION 01 // SKILLED LABOR &amp; FIELD OPERATORS</span>
    </div>
    <h1 data-gsap="hero-title">Your Trade Credentials Are<br><span>Government Contract Ready.</span></h1>
    <p data-gsap="hero-lead">EVOConnect maps skilled tradespeople to federal and state NAICS codes, connects you directly with certified subcontractors and prime contractors, and positions you for prevailing-wage infrastructure projects.</p>
    <div class="wfc-hero-cta" data-gsap="hero-cta">
      <a href="/labor/register" class="btn-primary">Initialize Worker Profile &mdash; Free</a>
      <a href="/login" class="btn-secondary-outline">Member Sign In</a>
    </div>
    <div class="wfc-hero-stats" data-gsap="hero-stats">
      <div class="hero-stat">
        <span class="num" data-count-to="13">13</span>
        <span class="lbl">Eligible Trade Tracks</span>
      </div>
      <div class="hero-stat-divider" aria-hidden="true"></div>
      <div class="hero-stat">
        <span class="num">$0</span>
        <span class="lbl">Registration Fee</span>
      </div>
      <div class="hero-stat-divider" aria-hidden="true"></div>
      <div class="hero-stat">
        <span class="num">Davis-Bacon</span>
        <span class="lbl">Prevailing Wage Focus</span>
      </div>
    </div>
  </div>
</section>

<!-- How It Works -->
<section class="wfc-section">
  <div class="wfc-section-inner">
    <div class="section-header text-center" data-gsap="section-header">
      <p class="section-label">01 // ONBOARDING SEQUENCE</p>
      <h2 class="section-title">Four Steps to Public Infrastructure Deployment</h2>
      <p class="section-subtitle">A streamlined pathway from trade verification to active project mobilization.</p>
    </div>
    <div class="hiw-grid evo-pipeline-grid">
      <div class="hiw-card spotlight-card" data-gsap="hiw-step">
        <div class="hiw-card-head">
          <div class="hiw-step">01</div>
          <span class="hiw-phase">CREDENTIALS</span>
        </div>
        <h3>Build Your Trade Profile</h3>
        <p>Log your primary trade, OSHA/CDL certifications, equipment experience, and deployment radius in under 5 minutes.</p>
      </div>
      <div class="hiw-card spotlight-card" data-gsap="hiw-step">
        <div class="hiw-card-head">
          <div class="hiw-step">02</div>
          <span class="hiw-phase">COMPLIANCE</span>
        </div>
        <h3>Complete Vendor Readiness</h3>
        <p>Use our interactive checklist to obtain your SAM.gov UEI, structure independent contractor compliance, or qualify for set-asides.</p>
      </div>
      <div class="hiw-card spotlight-card" data-gsap="hiw-step">
        <div class="hiw-card-head">
          <div class="hiw-step">03</div>
          <span class="hiw-phase">DISCOVERY</span>
        </div>
        <h3>Algorithmic Directory Match</h3>
        <p>Certified small businesses and prime contractors filter our directory by trade, NAICS code, and ZIP radius to source field talent.</p>
      </div>
      <div class="hiw-card spotlight-card" data-gsap="hiw-step">
        <div class="hiw-card-head">
          <div class="hiw-step">04</div>
          <span class="hiw-phase">MOBILIZATION</span>
        </div>
        <h3>Accept Direct Dispatches</h3>
        <p>Approve connection requests, apply directly to small-business trade jobs, and mobilize on funded public projects.</p>
      </div>
    </div>
  </div>
</section>

