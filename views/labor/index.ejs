<% const title = locals.title || 'Labor Portal' %>

<!-- Hero -->
<section class="wfc-hero">
  <div class="wfc-hero-inner">
    <span class="wfc-eyebrow">Labor Portal</span>
    <h1>Your Trade Is<br>Government Contract Ready.</h1>
    <p>EvoConnect matches skilled tradespeople with prime contractors working on government-funded projects. Build your profile, get vendor-ready, and get paid for what you know.</p>
    <div class="wfc-hero-cta">
      <a href="/labor/register" class="btn-primary">Register Free</a>
      <a href="/login" class="btn-secondary-outline">Already a Member? Log In</a>
    </div>
  </div>
</section>

<!-- How It Works -->
<section class="wfc-section">
  <div class="wfc-section-inner">
    <div class="section-header text-center">
      <h2 class="section-title">How It Works</h2>
      <p class="section-subtitle">Four simple steps from sign-up to getting paid on government work.</p>
    </div>
    <div class="hiw-grid">
      <div class="hiw-card">
        <div class="hiw-step">01</div>
        <h3>Create Your Profile</h3>
        <p>Sign up free. Enter your trade, skills, certifications, and location. Takes about 5 minutes.</p>
      </div>
      <div class="hiw-card">
        <div class="hiw-step">02</div>
        <h3>Get Vendor Ready</h3>
        <p>Follow our step-by-step checklist to get SAM.gov registered, HUB certified, and fully qualified.</p>
      </div>
      <div class="hiw-card">
        <div class="hiw-step">03</div>
        <h3>Get Discovered</h3>
        <p>Prime contractors search our directory by trade, location, and certifications. Your profile shows up when it matches.</p>
      </div>
      <div class="hiw-card">
        <div class="hiw-step">04</div>
        <h3>Connect &amp; Work</h3>
        <p>Accept connection requests, discuss opportunities, and start earning on government contracts.</p>
      </div>
    </div>
  </div>
</section>

<!-- Trade Categories -->
<section class="wfc-section" style="background:#0B1220;">
  <div class="wfc-section-inner">
    <div class="section-header text-center">
      <h2 class="section-title">Trades We Support</h2>
      <p class="section-subtitle">Government contracts need workers across every skilled trade. If your work builds or maintains infrastructure, there's a place for you.</p>
    </div>
    <div class="trades-grid">
      <div class="trade-card"><div class="trade-card-body"><h4>&#128241; Telecommunications &amp; Fiber</h4></div></div>
      <div class="trade-card"><div class="trade-card-body"><h4>&#9889; Electrical</h4></div></div>
      <div class="trade-card"><div class="trade-card-body"><h4>&#128295; Civil Construction</h4></div></div>
      <div class="trade-card"><div class="trade-card-body"><h4>&#128260; IT / Network Infrastructure</h4></div></div>
      <div class="trade-card"><div class="trade-card-body"><h4>&#128268; Underground Utilities</h4></div></div>
      <div class="trade-card"><div class="trade-card-body"><h4>&#129521; Plumbing</h4></div></div>
      <div class="trade-card"><div class="trade-card-body"><h4>&#10052; HVAC / Mechanical</h4></div></div>
      <div class="trade-card"><div class="trade-card-body"><h4>&#128167; Concrete / Masonry</h4></div></div>
      <div class="trade-card"><div class="trade-card-body"><h4>&#127959; Carpentry / Framing</h4></div></div>
      <div class="trade-card"><div class="trade-card-body"><h4>&#127881; Roofing</h4></div></div>
      <div class="trade-card"><div class="trade-card-body"><h4>&#127776; Painting / Finishing</h4></div></div>
      <div class="trade-card"><div class="trade-card-body"><h4>&#128663; Equipment Operation</h4></div></div>
      <div class="trade-card"><div class="trade-card-body"><h4>&#127959; General Laborer</h4></div></div>
    </div>
  </div>
</section>

<!-- Benefits -->
<section class="wfc-section">
  <div class="wfc-section-inner">
    <div class="section-header text-center">
      <h2 class="section-title">Why Join EvoConnect?</h2>
    </div>
    <div class="benefits-grid">
      <div class="benefit-card">
        <div class="benefit-icon">&#127919;</div>
        <h3>Matched Opportunities</h3>
        <p>We map your trade to active NAICS codes and surface government contract opportunities relevant to your skills.</p>
      </div>
      <div class="benefit-card">
        <div class="benefit-icon">&#9989;</div>
        <h3>Vendor Readiness Guide</h3>
        <p>Our built-in checklist walks you through every step to become fully eligible for government contract work.</p>
      </div>
      <div class="benefit-card">
        <div class="benefit-icon">&#128101;</div>
        <h3>Real Connections</h3>
        <p>Get direct connection requests from prime contractors actively bidding on projects that need your trade.</p>
      </div>
      <div class="benefit-card">
        <div class="benefit-icon">&#128176;</div>
        <h3>Government Pay Rates</h3>
        <p>Government contracts typically pay prevailing wages — often higher than private sector work in the same trade.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="wfc-cta-banner">
  <div class="wfc-cta-banner-inner">
    <h2 class="section-title">Your Next Contract Starts Here.</h2>
    <p>Register free and be discoverable by prime contractors in minutes.</p>
    <a href="/labor/register" class="btn-white">Create Your Free Profile</a>
  </div>
</section>
