<script>
(function () {
  const tabs = document.querySelectorAll('.naics-tab');
  const searchInput = document.getElementById('naics-matrix-search');
  const rows = document.querySelectorAll('#naics-matrix-tbody tr');
  if (!tabs.length || !rows.length) return;

  let activeSector = 'all';

  function filterRows() {
    const q = (searchInput ? searchInput.value : '').trim().toLowerCase();
    rows.forEach((row) => {
      const sectorMatch = activeSector === 'all' || row.getAttribute('data-sector') === activeSector;
      const textMatch = !q || row.textContent.toLowerCase().includes(q);
      row.style.display = (sectorMatch && textMatch) ? '' : 'none';
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      activeSector = tab.getAttribute('data-sector') || 'all';
      filterRows();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', filterRows);
  }
})();
</script>
