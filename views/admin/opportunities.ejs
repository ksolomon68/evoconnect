<% const title = locals.title || 'Opportunity Manager | EVOConnected Admin' %>
<% const oppList = locals.opportunities || [] %>

<%- include('../partials/flash') %>

<section class="hero-section">
    <div class="hero-content hero-welcome">
        <h1>📋 Opportunity Manager</h1>
        <p>Review, approve, publish, or close contracting opportunities across the EVOConnected platform.</p>
    </div>
</section>

<div class="recommendations-list" style="padding: var(--space-xl);">
    <div class="section-header">
        <a class="btn btn-primary" href="/admin/post-opportunity">Create opportunity</a><h2>All Platform Opportunities (<%= oppList.length %>)</h2>
    </div>

    <% if (oppList.length > 0) { %>
        <div style="overflow-x:auto;">
            <table class="data-table" style="width:100%;">
                <thead>
                    <tr>
                        <th>Ref</th>
                        <th>Title</th>
                        <th>Prime / Agency</th>
                        <th>Category</th>
                        <th>Value</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% oppList.forEach(function(opp) { %>
                    <tr>
                        <td data-label="Ref"><code><%= opp.project_ref || ('OPP-' + opp.id) %></code></td>
                        <td class="data-table-title"><a href="/opportunities/<%= encodeURIComponent(opp.id) %>"><strong><%= opp.title %></strong></a></td>
                        <td data-label="Prime / Agency"><%= opp.posted_by_name || 'Prime Contractor' %></td>
                        <td data-label="Category"><%= opp.category || 'General' %></td>
                        <td data-label="Value"><%= opp.estimated_value || 'TBD' %></td>
                        <td data-label="Due Date"><%= opp.due_date ? new Date(opp.due_date).toLocaleDateString() : 'Open' %></td>
                        <td data-label="Status">
                            <span class="status-badge <%= opp.status === 'published' ? 'badge-consulting' : 'badge-construction' %>" style="text-transform:capitalize;margin:0;">
                                <%= opp.status %>
                            </span>
                        </td>
                        <td data-label="Actions" class="data-table-actions">
                            <a class="btn btn-sm btn-secondary" href="/admin/opportunities/<%= encodeURIComponent(opp.id) %>/matches">Suggested partners</a>
                            <a class="btn btn-sm btn-secondary" href="/admin/opportunities/<%= encodeURIComponent(opp.id) %>/edit">Edit</a>
                            <form method="POST" action="/admin/opportunities/<%= opp.id %>/status" style="display:inline;">
                                <input type="hidden" name="status" value="<%= opp.status === 'published' ? 'closed' : 'published' %>">
                                <button type="submit" class="btn btn-sm btn-primary"><%= opp.status === 'published' ? 'Close' : 'Publish' %></button>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
                            <form method="POST" action="/admin/opportunities/<%= opp.id %>/delete" style="display:inline;" onsubmit="return confirm('Archive this opportunity? Application history will be retained.');">
                                <button type="submit" class="btn btn-sm btn-secondary">Archive</button>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <p style="color:var(--text-muted);text-align:center;padding:2rem;">No contracting opportunities found.</p>
    <% } %>
</div>

