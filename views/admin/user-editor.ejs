<section class="hero-section"><div class="hero-content"><h1><%= member.id ? 'Edit member' : 'Create member' %></h1></div></section>
<section class="recommendations-list" style="padding:var(--space-xl)"><% if(error) { %><p role="alert"><%= error %></p><% } %>
<form method="post" style="display:grid;gap:1rem" action="/admin/users/<%= member.id ? member.type+'/'+member.id+'/edit' : 'new' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if(!member.id) { %><label for="type">Role</label><select name="type" id="type" class="form-control"><% for(const type of ['worker','business','prime']) { %><option value="<%= type %>" <%= type===member.type?'selected':'' %>><%= type %></option><% } %></select><% } else { %><p>Role: <%= member.type %></p><% } %>
<% for(const [key,label,required] of [['name','Full name / company',true],['contact_name','Contact name',true],['email','Email',true],['phone','Phone',true],['city','City',false],['state','State (two-letter code)',false],['sam_uei','SAM UEI (required for prime contractors)',false]]) { %><div><label for="<%= key %>"><%= label %><%= required?' *':'' %></label><input class="form-control" type="<%= key==='email'?'email':'text' %>" id="<%= key %>" name="<%= key %>" value="<%= member[key] || (key==='contact_name' && member.type==='worker' ? member.name : '') || '' %>" <%= required?'required':'' %> maxlength="<%= key==='state'?2:255 %>"></div><% } %>
<label for="status">Account status</label><select id="status" name="status" class="form-control"><% for(const status of ['active','inactive','suspended']) { %><option value="<%= status %>" <%= (member.status || (member.active===0?'inactive':'active'))===status?'selected':'' %>><%= status %></option><% } %></select>
<% if(!member.id) { %><label for="password">Temporary password (at least 12 characters)</label><input id="password" type="password" name="password" minlength="12" required autocomplete="new-password" class="form-control"><% } %>
<p>Inactive or suspended members cannot access their account. Account records and application histories are retained.</p><button class="btn btn-primary">Save member</button><a href="/admin/users">Cancel</a></form></section>
