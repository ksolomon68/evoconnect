<% if (locals.user) { locals.layout = 'layouts/dashboard'; } %>
<% const title = locals.title || 'Admin Dashboard | EvoConnect' %>

<%- include('../partials/flash') %>

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content hero-welcome">
        <h1>🛡️ Admin Dashboard</h1>
        <p>Welcome back, <%= locals.user?.name ? locals.user.name.split(' ')[0] : 'Admin' %>! Manage users, opportunities, approvals, and platform settings.</p>
    </div>
</section>

<!-- Summary Cards -->
<section class="quick-stats">
    <div class="summary-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
        <div class="summary-card primary">
            <div class="summary-value"><%= (locals.stats?.workerCount || 0) + (locals.stats?.bizCount || 0) + (locals.stats?.primeCount || 0) %></div>
            <div class="summary-label">Total Registered Users</div>
        </div>
        <div class="summary-card success">
            <div class="summary-value"><%= locals.stats?.workerCount || 0 %> / <%= locals.stats?.bizCount || 0 %></div>
            <div class="summary-label">Workers / Businesses</div>
        </div>
        <div class="summary-card primary">
            <div class="summary-value"><%= locals.stats?.primeCount || 0 %></div>
            <div class="summary-label">Prime Contractors</div>
        </div>
        <div class="summary-card <%= (locals.stats?.pendingPrimes || 0) > 0 ? 'warning' : 'success' %>">
            <div class="summary-value"><%= locals.stats?.pendingPrimes || 0 %></div>
            <div class="summary-label">Pending Approvals</div>
        </div>
        <div class="summary-card primary">
            <div class="summary-value"><%= locals.stats?.connectionCount || 0 %></div>
            <div class="summary-label">Total Connections</div>
        </div>
    </div>
</section>

<!-- Global Administration Action Grid -->
<section class="action-section">
    <div class="section-header">
        <h2>🚀 Global Administration</h2>
    </div>
    <div class="action-grid">
        <a href="/admin/users" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">👥</div>
            <h3>User Management</h3>
            <p>View, filter, and manage workers, businesses, and prime contractors.</p>
        </a>
        <a href="/admin/approvals" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">✅</div>
            <h3>Prime Approvals</h3>
            <p>Review and approve pending prime contractor applications.</p>
        </a>
        <a href="/admin/opportunities" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">📋</div>
            <h3>Opportunity Manager</h3>
            <p>Approve, edit, or close contracting opportunities across the portal.</p>
        </a>
        <a href="/admin/naics" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">🏷️</div>
            <h3>NAICS Codes</h3>
            <p>Manage NAICS contract matching codes and set-aside eligibility.</p>
        </a>
        <a href="/admin/resources" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">📚</div>
            <h3>Resource Library</h3>
            <p>Add or update downloadable guides, templates, and videos.</p>
        </a>
        <a href="/admin/announcements" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">📢</div>
            <h3>Announcements</h3>
            <p>Send email broadcasts to workers, businesses, or primes.</p>
        </a>
        <a href="/admin/analytics" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">📊</div>
            <h3>Platform Analytics</h3>
            <p>Track weekly registrations, connections, and checklist metrics.</p>
        </a>
        <a href="/admin/issues" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">🚩</div>
            <h3>Reported Issues</h3>
            <p>Review technical reports and contact form submissions.</p>
        </a>
        <a href="/admin-cms" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">⚙️</div>
            <h3>Content Management (CMS)</h3>
            <p>Update public site copy, FAQs, and homepage sections.</p>
        </a>
        <a href="/admin/tutorial" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">📖</div>
            <h3>Platform Admin Guide</h3>
            <p>Step-by-step instructions for managing the EvoConnect platform.</p>
        </a>
        <a href="/admin/cms-tutorial" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">📝</div>
            <h3>CMS Admin Guide</h3>
            <p>Documentation for editing public website content and FAQs.</p>
        </a>
        <a href="/admin/export/csv" class="action-card">
            <div class="icon-box" style="background:var(--color-bg-secondary);">⬇️</div>
            <h3>Export CSV</h3>
            <p>Download complete platform registration and profile data.</p>
        </a>
    </div>
</section>

<!-- Main Details -->
<div class="dashboard-grid" style="display: grid; grid-template-columns: 1fr; gap: var(--space-xl); margin-top: var(--space-xl);">

    <!-- Pending Prime Approvals -->
    <div class="recommendations-list" style="padding: var(--space-xl);">
        <div class="section-header">
            <h2>Pending Prime Contractor Approvals</h2>
            <% if (locals.stats?.pendingPrimes > 0) { %>
                <span class="status-badge badge-construction"><%= locals.stats.pendingPrimes %> pending</span>
            <% } %>
        </div>
        <% if (locals.pendingList && pendingList.length > 0) { %>
            <div style="overflow-x:auto">
                <table class="data-table" style="width:100%">
                    <thead>
                        <tr>
                            <th>Company</th>
                            <th>Contact</th>
                            <th>Email</th>
                            <th>SAM UEI</th>
                            <th>Plan</th>
                            <th>Registered</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% pendingList.forEach(function(prime) { %>
                        <tr>
                            <td><strong><%= prime.company_name || '—' %></strong></td>
                            <td><%= prime.contact_name || '—' %></td>
                            <td><a href="mailto:<%= prime.email %>" style="color:var(--color-primary)"><%= prime.email %></a></td>
                            <td style="font-family:monospace;font-size:.85rem"><%= prime.sam_uei || '—' %></td>
                            <td><span class="status-badge badge-consulting" style="text-transform:capitalize;margin:0;"><%= prime.subscription_tier || 'basic' %></span></td>
                            <td><%= new Date(prime.created_at).toLocaleDateString() %></td>
                            <td style="white-space:nowrap">
                                <form method="POST" action="/admin/primes/<%= prime.id %>/approve" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-primary" style="margin-right:0.35rem;">Approve</button>
                                </form>
                                <form method="POST" action="/admin/primes/<%= prime.id %>/deny" style="display:inline">
                                    <input type="hidden" name="reason" value="">
                                    <button type="submit" class="btn btn-sm btn-secondary" onclick="return confirm('Deny this application? This will notify the applicant.')">Deny</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div style="padding:2rem;text-align:center;color:var(--text-muted)">
                <p>No pending approvals. All prime contractor applications are reviewed.</p>
            </div>
        <% } %>
    </div>

    <!-- Checklist Completion & Weekly Registrations -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:var(--space-xl);">
        <div class="recommendations-list" style="padding: var(--space-xl);">
            <div class="section-header">
                <h2>Checklist Completion by Track</h2>
            </div>
            <% if (locals.checklistStats && checklistStats.length > 0) { %>
                <table class="data-table" style="width:100%">
                    <thead>
                        <tr><th>User Type</th><th>Track</th><th>Total Completions</th></tr>
                    </thead>
                    <tbody>
                        <% checklistStats.forEach(function(row) { %>
                        <tr>
                            <td style="text-transform:capitalize"><%= row.user_type %></td>
                            <td style="text-transform:capitalize"><%= row.track %></td>
                            <td><strong><%= row.total_completions %></strong></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p style="color:var(--text-muted);text-align:center;padding:1rem;">No checklist data recorded yet.</p>
            <% } %>
        </div>

        <div class="recommendations-list" style="padding: var(--space-xl);">
            <div class="section-header">
                <h2>Weekly Activity (Last 8 Weeks)</h2>
            </div>
            <% if (locals.weeklyRegistrations && weeklyRegistrations.length > 0) { %>
                <table class="data-table" style="width:100%">
                    <thead><tr><th>Week</th><th>Registrations</th><th>Connections</th></tr></thead>
                    <tbody>
                        <% weeklyRegistrations.forEach(function(row, i) { %>
                        <tr>
                            <td style="font-family:monospace">Wk <%= row.week %></td>
                            <td><strong><%= row.count %></strong></td>
                            <td><%= locals.weeklyConnections?.[i]?.count || 0 %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p style="color:var(--text-muted);text-align:center;padding:1rem;">No weekly registration metrics recorded yet.</p>
            <% } %>
        </div>
    </div>
</div>
