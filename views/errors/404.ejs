<% const title = locals.title || 'Page Not Found' %>

<section class="error-section">
  <div class="container text-center">
    <div class="error-code">404</div>
    <h1 class="error-title">Page Not Found</h1>
    <p class="error-message">The page you're looking for doesn't exist or may have been moved.</p>
    <div class="error-actions">
      <a href="/" class="btn-primary">Go to Home</a>
      <% if (locals.user) { %>
        <% if (locals.user.type === 'worker') { %>
          <a href="/labor/dashboard" class="btn-secondary">My Dashboard</a>
        <% } else if (locals.user.type === 'business') { %>
          <a href="/business/dashboard" class="btn-secondary">My Dashboard</a>
        <% } else if (locals.user.type === 'prime') { %>
          <a href="/prime/dashboard" class="btn-secondary">My Dashboard</a>
        <% } else if (locals.user.type === 'admin') { %>
          <a href="/admin/dashboard" class="btn-secondary">Admin Dashboard</a>
        <% } %>
      <% } %>
    </div>
    <div class="error-help">
      <p>Looking for something specific?</p>
      <nav class="error-nav" aria-label="Helpful links">
        <a href="/labor">Labor Portal</a>
        <a href="/business">Business Portal</a>
        <a href="/prime">Prime Portal</a>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </div>
</section>
