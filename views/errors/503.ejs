<% const title = 'Maintenance Mode' %>
<div style="min-height:60vh;display:flex;align-items:center;justify-content:center;padding:4rem 1rem;text-align:center">
  <div>
    <div style="font-size:5rem;font-weight:900;color:#E2E8F0;line-height:1">503</div>
    <h1 style="font-size:1.75rem;font-weight:800;color:#0F172A;margin:.5rem 0 1rem">Down for Maintenance</h1>
    <p style="color:#64748B;max-width:400px;margin:0 auto 2rem">EvoConnect is undergoing scheduled maintenance. We'll be back shortly.</p>
    <p style="margin-top:2rem;font-size:.85rem;color:#94A3B8">
      Need urgent help? <a href="mailto:<%= cfg.email %>"><%= cfg.email %></a>
    </p>
  </div>
</div>
