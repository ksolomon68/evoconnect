<% const title = locals.title || 'Reset Password' %>

<section class="auth-section">
  <div class="container">
    <div class="auth-card">
      <div class="auth-logo" style="display:flex;align-items:center;justify-content:center;gap:0.65rem;margin-bottom:0.75rem;">
        <img src="/images/favicon.png" alt="" height="36" style="border-radius:8px;">
        <span style="font-family:var(--font-family-secondary, 'Plus Jakarta Sans', sans-serif);font-size:1.5rem;font-weight:800;letter-spacing:-0.02em;color:var(--color-text-primary, #F8FAFC);">EVO<span style="color:#06B6D4;">Connected</span></span>
      </div>
      <h1 class="auth-title">Set a New Password</h1>
      <p class="auth-subtitle">Choose a strong password of at least 8 characters.</p>

      <%- include('partials/flash') %>

      <form method="POST" action="/reset-password" class="auth-form" novalidate>
        <input type="hidden" name="token" value="<%= locals.token || '' %>">

        <!-- New Password -->
        <div class="form-group">
          <label for="password" class="form-label">New Password</label>
          <div class="input-with-toggle">
            <input
              type="password"
              id="password"
              name="password"
              class="form-control<%= locals.errors?.password ? ' is-invalid' : '' %>"
              required
              minlength="8"
              autocomplete="new-password"
              aria-describedby="password-hint<%= locals.errors?.password ? ' password-error' : '' %>"
            >
            <button type="button" class="toggle-password" aria-label="Show password" aria-pressed="false"><svg class="icon-eye" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="icon-eye-off" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><path d="M6.61 6.61A18.5 18.5 0 0 0 1 12s4 8 11 8a9.26 9.26 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg></button>
          </div>
          <span id="password-hint" class="field-hint">Minimum 8 characters</span>
          <% if (locals.errors?.password) { %><span class="field-error" id="password-error" role="alert"><%= errors.password %></span><% } %>
        </div>

        <!-- Confirm Password -->
        <div class="form-group">
          <label for="confirm_password" class="form-label">Confirm New Password</label>
          <input
            type="password"
            id="confirm_password"
            name="confirm_password"
            class="form-control<%= locals.errors?.confirm_password ? ' is-invalid' : '' %>"
            required
            autocomplete="new-password"
            aria-describedby="<%= locals.errors?.confirm_password ? 'confirm-password-error' : '' %>"
          >
          <% if (locals.errors?.confirm_password) { %><span class="field-error" id="confirm-password-error" role="alert"><%= errors.confirm_password %></span><% } %>
        </div>

        <button type="submit" class="btn-primary btn-full">Update Password</button>

        <div class="auth-links">
          <a href="/login">&larr; Back to Log In</a>
        </div>

      </form>
    </div>
  </div>
</section>
