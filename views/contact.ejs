<% const title = 'Contact | EVOGovCon' %>

<section class="wfc-section" style="padding: 5.5rem 1.5rem; min-height: 78vh; position: relative; overflow: hidden;">
  <div class="evo-grid-backdrop" aria-hidden="true"></div>
  <div class="container" style="max-width: 720px; position: relative; z-index: 1;">
    <div style="text-align: center; margin-bottom: 3rem;" data-gsap="section-header">
      <div class="wfc-eyebrow" style="margin-bottom: 1rem;" data-cms-field="page-header.eyebrow" data-cms-type="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>EXECUTIVE SUPPORT &amp; COMPLIANCE DESK</span>
      </div>
      <h1 style="font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; color: #F8FAFC; margin: 0 0 0.75rem; letter-spacing: -0.03em;" data-cms-field="page-header.heading">Contact EVOGovCon</h1>
      <p style="color: #94A3B8; font-size: 1.05rem; max-width: 520px; margin: 0 auto;" data-cms-field="page-header.body">Questions regarding vendor onboarding, NAICS classification, or prime contractor licensing? Our support desk is ready to assist.</p>
    </div>

    <%- include('./partials/flash') %>

    <div class="register-form spotlight-card" style="padding: 2.75rem; max-width: 100%;" data-gsap="auth-card">
      <form method="POST" action="/contact" id="contactForm">
        <div class="form-grid" style="margin-bottom: 0;">
          <div class="form-group">
            <label class="form-label" for="name">Full Name <span class="required">*</span></label>
            <input type="text" id="name" name="name" class="form-control" placeholder="Jane Smith" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="email">Work Email Address <span class="required">*</span></label>
            <input type="email" id="email" name="email" class="form-control" placeholder="jane@company.com" required>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="subject">Inquiry Classification <span class="required">*</span></label>
          <select id="subject" name="subject" class="form-control" required>
            <option value="">Select an inquiry category…</option>
            <option value="registration">Worker / Business Onboarding &amp; Registration</option>
            <option value="dashboard">Portal &amp; NAICS Matching Assistance</option>
            <option value="prime-approval">Prime Contractor Licensing &amp; Verification</option>
            <option value="billing">Enterprise Billing &amp; Subscription</option>
            <option value="technical">Technical Support</option>
            <option value="other">General Executive Inquiry</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="message">Detailed Message <span class="required">*</span></label>
          <textarea id="message" name="message" class="form-control" rows="5" placeholder="Provide details regarding your organization, NAICS focus, or support request…" required></textarea>
        </div>
        <button type="submit" class="btn-primary btn-full" style="margin-top: 0.5rem;">Transmit Inquiry</button>
      </form>
    </div>

    <div style="margin-top: 2rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
      <div class="benefit-card spotlight-card" style="padding: 1.5rem; text-align: left; display: flex; align-items: center; gap: 1rem;">
        <div class="benefit-icon" style="margin-bottom: 0; flex-shrink: 0;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <div>
          <div style="font-size: 0.72rem; font-family: var(--font-family-mono, monospace); text-transform: uppercase; letter-spacing: 0.08em; color: #94A3B8;">Direct Support Dispatch</div>
          <a href="mailto:<%= cfg.email %>" style="color: #06B6D4; font-weight: 600; font-size: 0.95rem; text-decoration: none;" data-cms-contact-email><%= cfg.email %></a>
        </div>
      </div>

      <div class="benefit-card spotlight-card" style="padding: 1.5rem; text-align: left; display: flex; align-items: center; gap: 1rem;">
        <div class="benefit-icon" style="margin-bottom: 0; flex-shrink: 0;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div>
          <div style="font-size: 0.72rem; font-family: var(--font-family-mono, monospace); text-transform: uppercase; letter-spacing: 0.08em; color: #94A3B8;">Operations Line</div>
          <a href="tel:<%= cfg.ownerPhone %>" style="color: #06B6D4; font-weight: 600; font-size: 0.95rem; text-decoration: none;" data-cms-contact-phone><%= cfg.ownerPhone %></a>
        </div>
      </div>
    </div>
  </div>
</section>
