<header class="site-header" role="banner">
  <div class="container nav-container">
    <a href="/" class="logo" aria-label="EvoConnect Home">
      <span>EvoConnect</span>
    </a>
    <button class="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="main-nav">
      <span></span><span></span><span></span>
    </button>
    <nav id="main-nav" class="main-nav" role="navigation" aria-label="Main navigation">
      <% if (!locals.user) { %>
        <a href="/" class="<%= locals.activePage === 'home' ? 'active' : '' %>">Home</a>
        <a href="/opportunities">Opportunities</a>
        <a href="/labor" class="<%= locals.activePage === 'labor' ? 'active' : '' %>">For Labor</a>
        <a href="/business" class="<%= locals.activePage === 'business' ? 'active' : '' %>">For Business</a>
        <a href="/prime" class="<%= locals.activePage === 'prime' ? 'active' : '' %>">For Primes</a>
        <a href="/login" class="btn btn-sm btn-ghost">Log In</a>
        <a href="/register" class="btn btn-sm btn-primary-nav">Register Free</a>
      <% } else if (locals.user.type === 'worker') { %>
        <a href="/labor/dashboard" class="<%= locals.activePage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/labor/search">Opportunities</a>
        <a href="/labor/messages">Messages</a>
        <a href="/labor/profile" class="<%= locals.activePage === 'profile' ? 'active' : '' %>">My Profile</a>
        <a href="/labor/faq" class="<%= locals.activePage === 'faq' ? 'active' : '' %>">FAQ</a>
        <a href="/logout" class="btn btn-sm btn-ghost">Log Out</a>
      <% } else if (locals.user.type === 'business') { %>
        <a href="/business/dashboard" class="<%= locals.activePage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/business/search">Opportunities</a>
        <a href="/business/messages">Messages</a>
        <a href="/business/profile" class="<%= locals.activePage === 'profile' ? 'active' : '' %>">My Profile</a>
        <a href="/business/capability-statement" class="<%= locals.activePage === 'capstatement' ? 'active' : '' %>">Capability Statement</a>
        <a href="/logout" class="btn btn-sm btn-ghost">Log Out</a>
      <% } else if (locals.user.type === 'prime') { %>
        <a href="/prime/dashboard" class="<%= locals.activePage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/prime/post-opportunity">Post Opportunity</a>
        <a href="/prime/opportunities">Manage Postings</a>
        <a href="/prime/search/businesses" class="<%= locals.activePage === 'search-businesses' ? 'active' : '' %>">Businesses</a>
        <a href="/prime/search/workers" class="<%= locals.activePage === 'search-workers' ? 'active' : '' %>">Labor</a>
        <a href="/prime/messages">Messages</a>
        <a href="/logout" class="btn btn-sm btn-ghost">Log Out</a>
      <% } else if (locals.user.type === 'admin') { %>
        <a href="/admin/dashboard">Admin Dashboard</a>
        <a href="/admin/users">Users</a>
        <a href="/admin/opportunities">Opportunities</a>
        <a href="/admin/messages">Messages</a>
        <a href="/logout" class="btn btn-sm btn-ghost">Log Out</a>
      <% } else { %>
        <a href="/">Home</a>
        <a href="/opportunities">Opportunities</a>
        <a href="/logout" class="btn btn-sm btn-ghost">Log Out</a>
      <% } %>
    </nav>
  </div>
</header>
