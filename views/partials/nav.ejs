<header class="site-header" role="banner">
  <div class="container nav-container">
    <%
      const dashboardHref = {
        worker: '/labor/dashboard',
        business: '/business/dashboard',
        prime: '/prime/dashboard',
        admin: '/admin/dashboard'
      }[locals.user && locals.user.type] || '/';
      // "/" auto-redirects a logged-in user to their dashboard, so the logo
      // and Home link need the escape hatch to actually land on the home page.
      const homeHref = locals.user ? '/?public=1' : '/';
    %>
    <a href="<%= homeHref %>" class="site-logo brand-logo-frame" aria-label="EVOGovCon Home">
      <img src="/images/evogovcon-logo.png" alt="EVOGovCon — Connecting workers, subs &amp; primes" class="brand-logo-image" width="2172" height="724">
    </a>
    <button class="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="main-nav">
      <span></span><span></span><span></span>
    </button>
    <nav id="main-nav" class="main-nav" role="navigation" aria-label="Main navigation">
      <a href="<%= homeHref %>" class="<%= locals.activePage === 'home' ? 'active' : '' %>">Home</a>
      <a href="/labor" class="<%= locals.activePage === 'labor' ? 'active' : '' %>">For Labor</a>
      <a href="/business" class="<%= locals.activePage === 'business' ? 'active' : '' %>">For Business</a>
      <a href="/prime" class="<%= locals.activePage === 'prime' ? 'active' : '' %>">For Primes</a>
      <a href="/opportunities">Opportunities</a>
      <a href="/faq" class="<%= locals.activePage === 'faq' ? 'active' : '' %>">FAQ</a>
      <% if (!locals.user) { %>
        <a href="/login" class="btn btn-sm btn-ghost">Log In</a>
        <a href="/register" class="btn btn-sm btn-primary-nav">Register Free</a>
      <% } else { %>
        <a href="<%= dashboardHref %>" class="btn btn-sm btn-ghost">Dashboard</a>
        <a href="/logout" class="btn btn-sm btn-primary-nav">Log Out</a>
      <% } %>
    </nav>
  </div>
</header>
